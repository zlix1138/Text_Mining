const winHeight = window.innerHeight;
const quickIndicators = document.querySelectorAll('.quick-list');

const quickNav = {
  init: () => {
    const quickIndicators = document.querySelectorAll('.quick-list');
    if (quickIndicators.length > 0) {
      quickNav.linkNav();
    }
  },
  reset: () => {
    const quickIndicators = document.querySelectorAll('.quick-list');
    quickIndicators.forEach(e => {
      const locationList = e.querySelectorAll('a');
      locationList.forEach(ele => {
        ele.classList.remove('active');
        ele.removeAttribute("title");
      });
    });
  },
  linkNav: () => {
    const quickIndicators = document.querySelectorAll('.quick-list');
    quickIndicators.forEach(e => {
      const locationList = e.querySelectorAll('a');
      locationList.forEach(ele => {
        const target = document.querySelector(ele.getAttribute('href'));

        ele.addEventListener('click', (ev) => {
          ev.preventDefault();

          target.scrollIntoView({
            behavior: 'smooth',
            block: 'center'
          });

          setTimeout(() => {
            quickNav.navHighlight();
          }, 800);
        });
      });
    });
  },
  navHighlight: () => {
    const quickIndicators = document.querySelectorAll('.quick-list');
    if (quickIndicators.length > 0) {
      const sectionArea = document.querySelectorAll('.scroll-check .conts-wrap');
      const scrollY = window.scrollY;
      const scrollH = document.body.scrollHeight;
      const winHeight = window.innerHeight;
      const topHeight = Math.ceil(winHeight / 4);
      const firstSecTop = sectionArea[0].offsetTop;

      sectionArea.forEach(current => {
        const sectionHeight = current.offsetHeight;
        const sectionTop = current.offsetTop;
        const sectionId = current.getAttribute("id");

        const activeLink = document.querySelector(".quick-type > .quick-nav a[href*=" + sectionId + "]");

        if (scrollY <= firstSecTop) {
          // 첫 번째 섹션이 화면 상단에 있을 때만 첫 번째 메뉴 활성화
          quickNav.reset();
          document.querySelector(".quick-type > .quick-nav .quick-list li:first-of-type a").classList.add("active");
            document.querySelector(".quick-type > .quick-nav .quick-list li:first-of-type a").setAttribute("title","선택됨");
        } else if (scrollY + winHeight >= scrollH) {
          // 마지막 섹션이 화면 하단에 있을 때만 마지막 메뉴 활성화
          quickNav.reset();
          document.querySelector(".quick-type > .quick-nav .quick-list li:last-of-type a").classList.add("active");
            document.querySelector(".quick-type > .quick-nav .quick-list li:last-of-type a").setAttribute("title","선택됨");
        } else if (scrollY >= sectionTop - topHeight && scrollY < sectionTop + sectionHeight) {
          // 현재 섹션에 있을 때만 해당 메뉴 활성화
          quickNav.reset();
          if (activeLink) {
            activeLink.classList.add("active");
            activeLink.setAttribute("title","선택됨");
          }
        }
      });
    }
  },
};

// DOMContentLoaded 이벤트가 발생한 후에 quickNav 초기화
window.addEventListener("DOMContentLoaded", () => {
    quickNav.init();
});

window.addEventListener('scroll', () => {
    quickNav.navHighlight();
});

window.addEventListener('resize', () => {
    winSizeSet();
});