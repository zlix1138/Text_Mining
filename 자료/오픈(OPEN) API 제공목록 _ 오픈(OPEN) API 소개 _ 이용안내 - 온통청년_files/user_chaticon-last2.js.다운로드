                    d.style.width = storedImgWidth + 'px';
                    d.style.maxWidth = storedImgWidth + 'px';
                    d.style.maxHeight = storedImgHeight + 'px';
                } else {
                    d.style.height = storedImgHeight + 'px';
                    d.style.width = storedImgWidth + 'px';
                    d.style.maxWidth = '300px';
                    d.style.maxHeight = '300px';
                }
            }
            resetChatWidgetStyles(d);
        }
    });

    function resetChatWidgetStyles(chatWidget) {
        const resizers = document.querySelectorAll('.borderss');
        const draggableArea = document.querySelector('.touches');

        if (!chatWidget.classList.contains('aabbccdd')) {
            resizers.forEach(resizer => resizer.style.display = 'none'); 
            if (draggableArea) draggableArea.style.display = 'block';
        }
    }

    let focusedWidget = false;
    draggableArea.setAttribute('tabindex', '0');
    draggableArea.title = '키보드 제어: ↑ ↓ ← → 창 이동 (Shift + 방향키 = 빠른 이동)';

    draggableArea.addEventListener('focus', () => {
        focusedWidget = true;
        //draggableArea.style.opacity = '0.8';
		if (!draggableArea.querySelector('.tooltip-text')) {
			const tipSpan = document.createElement('span');
			tipSpan.className = 'tooltip-text';
			tipSpan.textContent = '방향키(↑↓←→)로 아이콘 위치를 이동할 수 있습니다.';
			draggableArea.appendChild(tipSpan);
		}
    });
    
    draggableArea.addEventListener('blur', () => {
        focusedWidget = false;
        draggableArea.style.opacity = '';
		const tip = draggableArea.querySelector('.tooltip-text');
		if (tip) tip.remove();
		draggableArea.style.opacity = '';
    });
    
    d.addEventListener('mouseenter', () => {
        focusedWidget = true;
    });
    
    d.addEventListener('mouseleave', () => {
        setTimeout(() => {
            if (!draggableArea.matches(':focus')) {
                focusedWidget = false;
            }
        }, 100);
    });

    function onKeyDownForDrag(e) {

        if (!e.key.startsWith('Arrow')) return;
        
        const isOpen = d.classList.contains('aabbccdd');
        if (!focusedWidget && !isOpen) return;

        const activeElement = document.activeElement;
        if (activeElement && (activeElement.tagName === 'INPUT' || 
                              activeElement.tagName === 'TEXTAREA' ||
                              activeElement.isContentEditable)) {
            return;
        }
        
        const step = e.shiftKey ? 20 : 10;
        let moveX = 0, moveY = 0;
        
        switch(e.key) {
            case 'ArrowUp':
                moveY = -step;
                e.preventDefault();
                break;
            case 'ArrowDown':
                moveY = step;
                e.preventDefault();
                break;
            case 'ArrowLeft':
                moveX = -step;
                e.preventDefault();
                break;
            case 'ArrowRight':
                moveX = step;
                e.preventDefault();
                break;
        }
        
        if (moveX === 0 && moveY === 0) return;
        
        let currentRight = parseFloat(d.style.right);
        let currentBottom = parseFloat(d.style.bottom);
        
        if (isNaN(currentRight)) currentRight = 0;
        if (isNaN(currentBottom)) currentBottom = 0;
        
        let newRight = currentRight - moveX;
        let newBottom = currentBottom - moveY;
        
        const windowWidth = window.innerWidth;
        const windowHeight = window.innerHeight;
        const widgetWidth = d.offsetWidth;
        const widgetHeight = d.offsetHeight;
        const minTop = getMinTop();
        
        const maxRight = Math.max(0, windowWidth - widgetWidth);
        const maxBottom = Math.max(0, windowHeight - widgetHeight - minTop);
        
        newRight = Math.max(0, Math.min(newRight, maxRight));
        newBottom = Math.max(0, Math.min(newBottom, maxBottom));
        
        d.style.right = newRight + 'px';
        d.style.bottom = newBottom + 'px';
        
        targetRight = newRight;
        targetBottom = newBottom;
        
        saveCurrentPosition();

        d.style.transition = 'right 0.05s ease, bottom 0.05s ease';
        setTimeout(() => {
            d.style.transition = '';
        }, 100);
        
       // console.log(`이동: right=${newRight}px, bottom=${newBottom}px`);
    }
    
    document.addEventListener('keydown', onKeyDownForDrag);
})();
})();