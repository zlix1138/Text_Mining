    d.style.height = '100%';
    d.style.maxWidth = maxwidth;
    d.style.maxHeight = maxheight;
    d.style.colorScheme = 'normal';
    d.style.display = 'none';
    //console.log("aaaaaa", chBc)

    // localStorage에서 설정값을 읽어서 URL 매개변수로 전달
    const savedChatExpand = localStorage.getItem('chat_expand');
    const savedBorder = localStorage.getItem('chat_border');
