        }

        resizer.style.display = 'none';
        resizers[direction] = resizer;
        d.appendChild(resizer);
    });

    if (targetParent) {
        targetParent.appendChild(d); 
    } else {
        document.body.appendChild(d); 
    }

    let targetRight = null;
    let targetBottom = null;
    let dragClose = null;
    let wasDraggedWhileExpanded = false;
    let beforeExpandRight = null;
    let beforeExpandBottom = null;
    let beforeExpandWidth = null;
    let beforeExpandHeight = null;

    // ========== 저장된 위치를 뷰포트에 맞게 조정하는 함수 ==========
    function adjustPositionToViewport(savedRight, savedBottom) {
        const windowHeight = window.innerHeight;
        const windowWidth = window.innerWidth;
        const widgetHeight = d.offsetHeight;
        const widgetWidth = d.offsetWidth;
        // touches 존재하고 no 클래스가 없으면 40px 여백 필요
        const touchesEl = document.querySelector('.touches');
        const needReserve = (touchesEl !== null && !touchesEl.classList.contains('no'));
        const reserve = needReserve ? 40 : 0;
        const reserveRight = getMinRight();

        let newBottom = parseFloat(savedBottom);
        let newRight = parseFloat(savedRight);
        
        // bottom이 화면을 벗어나면 바닥에 붙임
        if (newBottom + widgetHeight >= windowHeight - reserve) {
            newBottom = windowHeight - widgetHeight - reserve;
        }
        
        // right이 화면을 벗어나면 오른쪽에 붙임
		const maxRight = windowWidth - widgetWidth - reserveRight;
		if (newRight > maxRight) {
			newRight = Math.max(0, maxRight);
		}
        
        // 0 미만이 되지 않도록 보호
        newBottom = Math.max(0, newBottom);
        newRight = Math.max(0, newRight);
        return { right: newRight, bottom: newBottom };
    }

    const savedPos = loadSavedPosition();
    if (savedPos && savedPos.right !== undefined && savedPos.bottom !== undefined) {
        // 저장된 위치를 뷰포트에 맞게 조정
        const adjusted = adjustPositionToViewport(savedPos.right, savedPos.bottom);
        d.style.right = adjusted.right + 'px';
        d.style.bottom = adjusted.bottom + 'px';
        targetRight = adjusted.right;
        targetBottom = adjusted.bottom;
        
        // 위치가 조정되었으면 다시 저장
        if (adjusted.right !== parseFloat(savedPos.right) || adjusted.bottom !== parseFloat(savedPos.bottom)) {
            saveCurrentPosition();
        }
    } else {
        // 저장된 위치가 없으면 기본값 사용
		//console.log("rightn", rightn);
        //d.style.right = rightn;
        //d.style.bottom = bottomn;
    }

    // ========== 경계 보정 함수 ==========
    let resizeTimer;
    
	function fixWidgetInView() {
		if (!d) return;
		const isOpen = d.classList.contains('aabbccdd');
		
		if (!isOpen && !shouldPersistPosition()) {
			let finalRight = rightn;
			let finalBottom = bottomn;
			
			if (dragClose === 'on' && !d.classList.contains('aabbccdd') && !document.querySelector('.touches')?.classList.contains('no')) {
				let rightValue = parseFloat(rightn);
				if (!isNaN(rightValue)) {
					finalRight = (rightValue) + 'px';
				}
			}
			
			d.style.right = finalRight;
			d.style.bottom = finalBottom;
			return;
		}
		
		if (isDragging) return;
		
		const windowWidth = window.innerWidth;
		const windowHeight = window.innerHeight;
		const widgetWidth = d.offsetWidth;
		const widgetHeight = d.offsetHeight;
		
		if (widgetHeight === 0 || widgetWidth === 0) {
			setTimeout(() => fixWidgetInView(), 50);
			return;
		}
		
		let currentRight = parseFloat(d.style.right);
		let currentBottom = parseFloat(d.style.bottom);
		if (isNaN(currentRight)) currentRight = 0;
		if (isNaN(currentBottom)) currentBottom = 0;
		
		// 올바른 minTop 값을 강제로 가져오기
		const touchesEl = document.querySelector('.touches');
		const needTopSpace = (touchesEl !== null && !touchesEl.classList.contains('no'));
		const minTop = needTopSpace ? 40 : 0;
		const minRight = getMinRight();
		
		// 핵심 수정: top이 범위를 벗어나지 않도록 bottom의 최대값 계산
		// top = windowHeight - widgetHeight - bottom
		// 조건: top >= minTop
		// 따라서 bottom <= windowHeight - widgetHeight - minTop
		const maxBottom = Math.max(0, windowHeight - widgetHeight - minTop);
		const maxRight = Math.max(0, windowWidth - widgetWidth);
		
		let newRight = Math.max(minRight, Math.min(currentRight, maxRight));
		let newBottom = Math.max(0, Math.min(currentBottom, maxBottom));
		
		// 추가 디버그 로그
		/*console.log('fixWidgetInView:', {
			windowHeight,
			widgetHeight,
			newRight,
			minTop,
			maxBottom,
			currentBottom,
			newBottom
		});*/
		
		if (newRight !== currentRight || newBottom !== currentBottom) {
			targetRight = newRight;
			targetBottom = newBottom;
			d.style.right = newRight + 'px';
			d.style.bottom = newBottom + 'px';
		}
	}
    
    window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        fixWidgetInView();
        resizeTimer = setTimeout(() => {
            fixWidgetInView();
        }, 150);
    });

    // ========== 드래그 기능 ==========
    let isDragging = false;
    let startX = 0, startY = 0;
    let startRight = 0, startBottom = 0;

    function canDrag() {
        const isOpen = d.classList.contains('aabbccdd');
        if (isOpen) return true;
        const touchesEl = document.querySelector('.touches');
        return touchesEl !== null && !touchesEl.classList.contains('no');
    }

    function onDragStart(clientX, clientY) {
        if (!canDrag()) return false;

        const rect = d.getBoundingClientRect();
        const windowWidth = window.innerWidth;
        const windowHeight = window.innerHeight;

        startRight = windowWidth - rect.right - 11;
        startBottom = windowHeight - rect.bottom;
        startX = clientX;
        startY = clientY;
        
        isDragging = true;
        
        d.style.willChange = 'right, bottom';
        d.style.transition = 'none';
        d.style.cursor = 'grabbing';
        d.classList.add('dragging');
        
        document.body.style.userSelect = 'none';
        
        return true;
    }

    function onDragMove(clientX, clientY) {
        if (!isDragging) return;
        
        const dx = clientX - startX;
        const dy = clientY - startY;
        
        let newRight = startRight - dx;
        let newBottom = startBottom - dy;
        
        const windowWidth = window.innerWidth;
        const windowHeight = window.innerHeight;
        const widgetWidth = d.offsetWidth;
        const widgetHeight = d.offsetHeight;
        const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
        const availableWidth = windowWidth - scrollbarWidth;
        const minTop = getMinTop();
		const minRight = getMinRight();
        
        const maxRight = Math.max(0, availableWidth - widgetWidth - minRight);
        const maxBottom = Math.max(0, windowHeight - widgetHeight - minTop);
        
        newRight = Math.max(minRight, Math.min(newRight, maxRight));
        newBottom = Math.max(0, Math.min(newBottom, maxBottom));
        
        targetRight = newRight;
        targetBottom = newBottom;
        
        d.style.right = newRight + 'px';
        d.style.bottom = newBottom + 'px';
    }

    function onDragEnd() {
        if (!isDragging) return;
        
        isDragging = false;
        
        d.style.willChange = '';
        d.style.transition = '';
        d.style.cursor = '';
        d.classList.remove('dragging');
        document.body.style.userSelect = '';
        
        targetRight = parseFloat(d.style.right);
        targetBottom = parseFloat(d.style.bottom);
        
        if (d.classList.contains('aabbccdd')) {
            wasDraggedWhileExpanded = true;
        }

		try {
			const rightVal = d.style.right;
			const bottomVal = d.style.bottom;
			if (rightVal && bottomVal) {
				localStorage.setItem('chat_float_pos', JSON.stringify({
					right: rightVal,
					bottom: bottomVal
				}));
			}
		} catch(e) { console.log('저장 실패:', e); }

        saveCurrentPosition();
        fixWidgetInView();
    }

    draggableArea.addEventListener('mousedown', (e) => {
        if (e.button !== 0) return;
        e.preventDefault();
        e.stopPropagation();
        
        if (onDragStart(e.clientX, e.clientY)) {
            const mouseMoveHandler = (moveEvent) => {
                moveEvent.preventDefault();
                onDragMove(moveEvent.clientX, moveEvent.clientY);
            };
            
            const mouseUpHandler = () => {
                onDragEnd();
                document.removeEventListener('mousemove', mouseMoveHandler);
                document.removeEventListener('mouseup', mouseUpHandler);
            };
            
            document.addEventListener('mousemove', mouseMoveHandler);
            document.addEventListener('mouseup', mouseUpHandler);
        }
    });

    draggableArea.addEventListener('touchstart', (e) => {
        if (e.touches.length !== 1) return;
        e.preventDefault();
        e.stopPropagation();
        
        const touch = e.touches[0];
        if (onDragStart(touch.clientX, touch.clientY)) {
            const touchMoveHandler = (moveEvent) => {
                moveEvent.preventDefault();
                const touch = moveEvent.touches[0];
                onDragMove(touch.clientX, touch.clientY);
            };
            
            const touchEndHandler = () => {
                onDragEnd();
                document.removeEventListener('touchmove', touchMoveHandler);
                document.removeEventListener('touchend', touchEndHandler);
            };
            
            document.addEventListener('touchmove', touchMoveHandler, { passive: false });
            document.addEventListener('touchend', touchEndHandler);
        }
    });

    function fixPositionWhenExpand() {
        if (!d.classList.contains('aabbccdd')) return;

        const windowWidth = window.innerWidth;
        const windowHeight = window.innerHeight;
        const widgetWidth = d.offsetWidth;
        const widgetHeight = d.offsetHeight;
        const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
        const availableWidth = windowWidth - scrollbarWidth;

        let newRight, newBottom;
        
        if (beforeExpandRight !== null && beforeExpandBottom !== null) {
            newRight = beforeExpandRight;
            newBottom = beforeExpandBottom;
        } else if (targetRight !== null && targetBottom !== null) {
            newRight = targetRight;
            newBottom = targetBottom;
        } else {
            newRight = 0;
            newBottom = 0;
        }

        const maxRight = Math.max(0, availableWidth - widgetWidth);
        const maxBottom = Math.max(0, windowHeight - widgetHeight);
        newRight = Math.max(0, Math.min(newRight, maxRight));
        newBottom = Math.max(0, Math.min(newBottom, maxBottom));

        d.style.right = newRight + 'px';
        d.style.bottom = newBottom + 'px';
        
        targetRight = newRight;
        targetBottom = newBottom;
        
        saveCurrentPosition();
    }

    let isResizing = false;
    const startResize = (direction, e) => {
        isResizing = true;

        Object.entries(resizers).forEach(([dir, resizer]) => {
            if (dir !== direction) {
                resizer.style.pointerEvents = 'none'; 
            }
        });

        const origWidth = d.offsetWidth;
        const origHeight = d.offsetHeight;
        const origX = e.clientX;
        const origY = e.clientY;
        const origRight = parseFloat(d.style.right);
        const origBottom = parseFloat(d.style.bottom);

        const resizeHandler = (e) => {
            if (!isResizing) return;

            let newWidth = origWidth;
            let newHeight = origHeight;
            let newRight = origRight;
            let newBottom = origBottom;

            if (direction === 'right') {
                newWidth = origWidth + (e.clientX - origX);
                newRight = origRight - (e.clientX - origX);
            } else if (direction === 'left') {
                newWidth = origWidth - (e.clientX - origX);
                newRight = origRight + (e.clientX - origX);
            } else if (direction === 'bottom') {
                newHeight = origHeight + (e.clientY - origY);
