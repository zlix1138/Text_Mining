(function() {

// ========== 보조 함수 ==========
function setCookie(name, value, hours, path = '/') {
    let expires = '';
    if (hours) {
        const date = new Date();
        date.setHours(23, 59, 59, 999);
        expires = '; expires=' + date.toUTCString();
    }
    document.cookie = encodeURIComponent(name) + '=' + encodeURIComponent(value) + expires + '; path=' + path;
}

function getCookie(name) {
    const encodedName = encodeURIComponent(name) + '=';
    const cookies = document.cookie.split('; ');
    for (let cookie of cookies) {
        if (cookie.indexOf(encodedName) === 0) {
            return decodeURIComponent(cookie.substring(encodedName.length));
        }
    }
    return null;
}

// ========== 위치 저장 필요 여부 확인 ==========
function shouldPersistPosition() {
    const touchesEl = document.querySelector('.touches');
    return touchesEl !== null && !touchesEl.classList.contains('no');
}

// ========== 상단 최소 여백 가져오기 ==========
// touches가 존재하고 no 클래스가 없으면,
// 드래그 핸들이 가려지지 않도록 상단에 40px 여백 추가
function getMinTop() {
    const touchesEl = document.querySelector('.touches');
    if (touchesEl !== null && !touchesEl.classList.contains('no')) {
        return 40;
    }
    return 0;
}
function getMinRight() {
    const chbCloseEl = document.querySelector('.chbClose');
    if (chbCloseEl && chbCloseEl.style.display !== 'none') {
        return 20;  
    }
    return 0;
}

// ========== 위치를 localStorage에 저장 (오직 right/bottom) ==========
function saveCurrentPosition() {
    const d = document.querySelector('.chat-widget');
    if (!d) return;
    if (!d.style.right || !d.style.bottom) return;
    
    try {
        let rightNum = parseFloat(d.style.right);
		if(rightNum <= 20 && parseFloat(rightn) > 0){
			rightNum = parseFloat(rightn);
		}
		let bottomNum = parseFloat(d.style.bottom);
    if (rightNum === 0 && bottomNum === 0) {
        console.trace();
    }

        if (!isNaN(rightNum) && !isNaN(bottomNum) && (rightNum > 0 || bottomNum > 0)) {
             // 숫자 형식으로 쓰기 (last.js용)
            localStorage.setItem('chat_widget_pos', JSON.stringify({
                right: rightNum,
                bottom: bottomNum
            }));
            // px 형식으로 쓰기( last2.js 자체 사용을 위해)
            localStorage.setItem('chat_float_pos', JSON.stringify({
                right: rightNum + 'px',
                bottom: bottomNum + 'px'
            }));
			//debugger
        }
    } catch (e) {}
}

// ========== 저장된 위치 읽기 ==========
function loadSavedPosition() {
    if (!shouldPersistPosition()) {
        return null;
    }
    
    try {
        // 통일된 것을 우선적으로 읽기 chat_widget_pos
        let saved = localStorage.getItem('chat_widget_pos');
        if (saved) {
            const pos = JSON.parse(saved);
            // last2.js에 필요한 형식(px가 포함된 문자열)으로 변환
            return {
                right: pos.right + 'px',
                bottom: pos.bottom + 'px'
            };
        }
        
        // 구형과 호환되는 chat_float_pos
        saved = localStorage.getItem('chat_float_pos');
        if (saved) {
            return JSON.parse(saved);
        }
    } catch (e) {}
    return null;
}

