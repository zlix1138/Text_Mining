                let shareUrl = (!YTHIPutil.isEmpty($this.data("shareurl")))? $this.data("shareurl"):location.pathname;
                if(!shareUrl.startsWith("http://") && !shareUrl.startsWith("https://")){
                    shareUrl = YTHIPcomm.API_FRT_URL + shareUrl;
                }
                let shareTitle = (!YTHIPutil.isEmpty($this.data("sharetitle")))? $this.data("sharetitle"):"온통청년";

                $("span.url-box input", $itemShare).val(shareUrl);
                // 버튼 : URL 복사
                $(".btn-url", $itemShare).off("click").YTHIPon("click", function(){
                    const $this = $(this);
                    navigator.clipboard.writeText($("span.url-box input", $itemShare).val())
                        .then(()=>{
                            YTHIPcomm.alert({title:"알림", msg:"URL 주소가 복사되었습니다."}, $this);
                        })
                        .catch(()=> {
                            YTHIPcomm.alert({title:"오류", msg:"이 브라우저는 지원하지 않습니다."}, $this);
                        })
                });

                // 버튼 : FACEBOOK
                $("a._btnFacebook", $itemShare).off("click").YTHIPon("click", function(){
                    YTHIPutil.sns.facebook(shareUrl, shareTitle);
                });

                // 버튼 : KAKAO
                $("a._btnKakao", $itemShare).off("click").YTHIPon("click", function(){
                    YTHIPutil.sns.kakao(shareUrl, shareTitle);
                });

                // 버튼 : NAVER BAND
                $("a._btnBand", $itemShare).off("click").YTHIPon("click", function(){
                    YTHIPutil.sns.band(shareUrl, shareTitle);
                });

                // 버튼 : NAVER BLOG
                $("a._btnBlog", $itemShare).off("click").YTHIPon("click", function(){
                    YTHIPutil.sns.blog(shareUrl, shareTitle);
                });

                // 버튼 : X
                $("a._btnX", $itemShare).off("click").YTHIPon("click", function(){
                    YTHIPutil.sns.twitter(shareUrl, shareTitle);
                });



                // 버튼 : 공유하기 닫기
                $(".btn-close", $itemShare).off("click").YTHIPon("click", function(){
                    $this.closest('.btn-share').removeClass('active');
                    $(this).closest('.item-share').removeClass('active');
                    $(this).closest('.item-share').remove();
                });
            });

        }

        return {
            init : _init
        }
    }();

    const _ctpvSgg = function(){

        const _init = function(){
            if(!YTHIPcomm.sessStorage.get("ctpvCnt") || !YTHIPcomm.sessStorage.get("ctpvSggCnt")) {
                let count = 0;
                YTHIPcomm.promise("GET", YTHIPcomm.API_FRT_URL + "/go/ythip/getCtpvCd", {}).then(data => {
                    const lastidx = data.admVOList.totalCount - 1;
                    YTHIPcomm.sessStorage.set("ctpvCnt", data.admVOList.totalCount);
                    $.each(data.admVOList.admVOList, function (i, v) {
                        YTHIPcomm.promise("GET", YTHIPcomm.API_FRT_URL + "/go/ythip/getSggCd/" + v.admCode, {}).then(data2 => {
                            count += parseInt(data2.admVOList.totalCount);
                            if (i === lastidx){
                                YTHIPcomm.sessStorage.set("ctpvSggCnt", count);
                            }
                        });
                    })
                })
            }
        }

        const _init2 = function(){
            YTHIPcomm.sessStorage.set("ctpvCnt", parseInt(__ctpvCnt));
            YTHIPcomm.sessStorage.set("ctpvSggCnt", parseInt(__ctpvSggCnt));
        }

        return {
            init : _init2,
            init2 : _init
        }

    }();

    return {
        menu  : _menu
        , code : _code
        , comm : _comm
        , ctpvSgg : _ctpvSgg
    }
}();