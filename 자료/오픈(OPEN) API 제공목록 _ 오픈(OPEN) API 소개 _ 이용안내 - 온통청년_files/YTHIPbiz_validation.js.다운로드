    /**
     * 필드별로 검증 이벤트를 초기화
     * @param {Array|null} fieldsToValidate - 검증할 필드 목록
     * @private
     */
    const _initFldEvent = function(fieldsToValidate = null) {
        const formFields = fieldsToValidate || Object.keys(RULES);

        formFields.forEach(field => {
            const $field = $(`[name="${field}"]`).length > 0 ? $(`[name="${field}"]`) : $(`#${field}`);

            if ($field.is(':radio')) {
                // radio 그룹의 change 이벤트 처리
                $field.on('change', function() {
                    const formData = _collectFormData();
                    const value = $(`[name="${field}"]:checked`).val(); // 선택된 radio 버튼의 값
                    const result = _validateField(field, value, formData);

                    if (!result.isValid) {
                        applyFieldErrorStyle($field.closest('.checks')); // radio 그룹의 상위 컨테이너에 에러 스타일 적용
                    } else {
                        removeFieldErrorStyle($field.closest('.checks')); // radio 그룹의 상위 컨테이너에서 에러 스타일 제거
                    }
                });
            } else if ($field.is(':checkbox')) {
                // checkbox 그룹의 change 이벤트 처리
                $field.on('change', function() {
                    const formData = _collectFormData();
                    const values = $(`[name="${field}"]:checked`).map(function() {
                        return this.value;
                    }).get(); // 선택된 checkbox 값 배열로 수집
                    const result = _validateField(field, values, formData);

                    if (!result.isValid) {
                        applyFieldErrorStyle($field.closest('.checks')); // checkbox 그룹의 상위 컨테이너에 에러 스타일 적용
                    } else {
                        removeFieldErrorStyle($field.closest('.checks')); // checkbox 그룹의 상위 컨테이너에서 에러 스타일 제거
                    }
                });
            } else {
                // 일반 input 이벤트 처리
                $field.on('input', function() {
                    const formData = _collectFormData();
                    const result = _validateField(field, $(this).val(), formData);

                    if (!result.isValid) {
                        applyFieldErrorStyle($field); // 외곽선 유지
                    } else {
                        removeFieldErrorStyle($field); // 외곽선 제거
                    }
                });
            }
        });
    };





    /**
     * 필드별로 검증 이벤트를 제거
     * @param {Array|null} fieldsToRemove - 이벤트를 제거할 필드 목록
     * @private
     */
    const _removeFldEvent = function(fieldsToRemove = null) {
        const formFields = fieldsToRemove || Object.keys(RULES); // 제거할 필드 목록 설정
        formFields.forEach(field => {
            const $field = $(`#${field}`);
            const isCheckboxOrRadio = $field.is('[type="checkbox"]') || $field.is('[type="radio"]');

            if (isCheckboxOrRadio) {
                $field.off('change'); // 체크박스 및 라디오 버튼의 change 이벤트 제거
            } else if ($field.is('select')) {
                $field.off('change'); // select 요소의 change 이벤트 제거
            } else {
                $field.off('blur'); // 일반 입력 필드의 blur 이벤트 제거
            }
        });
    };


    /**
     * 폼 데이터 수집 메서드
     * @returns {Object} 폼 데이터 객체
     * @private
     */
    const _collectFormData = function() {
        const formData = {};
        Object.keys(RULES).forEach(field => {
            const $field = $(`[name="${field}"]`).length > 0 ? $(`[name="${field}"]`) : $(`#${field}`);

            if ($field.is(':radio')) {
                // 선택된 radio 버튼의 값만 수집
                formData[field] = $(`[name="${field}"]:checked`).val() || null;
            } else if ($field.is(':checkbox')) {
                // 체크박스의 선택된 값을 배열로 수집
                formData[field] = $(`[name="${field}"]:checked`).map(function() {
                    return this.value;
                }).get();
            } else {
                // 기본 input 값 수집
                formData[field] = $field.val();
            }
        });
        return formData;
    };


    /**
     * 외부에서 접근 가능한 메서드
     * @type {{addForm: Function, alertValidMsg: Function, validateForm: Function, displayErrors: Function, removeFldEvent: Function, initFldEvent: Function}}
     * @public
     */
    return {
        initRules: _initRules,
        initForm: _initForm,
        addForm: _addForm,
        alertValidMsg: _alertValidMsg,
        validateForm: validateForm,
        removeFldEvent: _removeFldEvent,
        initFldEvent: _initFldEvent,
        RULES: RULES,
    };
}();
