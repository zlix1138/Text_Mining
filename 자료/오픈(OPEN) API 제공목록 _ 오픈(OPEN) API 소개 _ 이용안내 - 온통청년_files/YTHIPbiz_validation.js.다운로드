const YTHIP_validation = function() {
    /**
     * 검증 규칙을 정의한 객체
     * 필드별로 검증 규칙과 에러 메시지를 설정
     * @type {Object}
     * @private
     */
    let RULES = {};

    /**
     * 폼 데이터를 저장하는 객체, _validateForm 함수에서 이 custom 객체도 포함
     * @type {Object}
     * @private
     */
    let _form = {};

    const _initRules = function(customRules = {}) {
        RULES = { ...RULES, ...customRules };
    }

    const _initForm = function() {
        _form = {};
    }

    /**
     * 검증 데이터 추가 메서드
     * @param {string} key - 폼 데이터 키
     * @param {*} value - 폼 데이터 값
     * @private
     */
    const _addForm = function(key, value) {
        _form[key] = value;
    };

    /**
     * 검증 실패 시 사용자에게 알림 메시지를 표시
     * @param {Object} validationResult - 검증 결과 객체
     * @private
     */
    const _alertValidMsg = function(validationResult) {
        const errorKeys = Object.keys(validationResult.errors); // 에러 키 목록
        const errorCount = errorKeys.length; // 에러 개수
        if (errorCount > 0) {
            const topErrorField = validationResult.topLevelField || errorKeys[0];
            const errorMessage = validationResult.errors[topErrorField];
            let $focusElement ;

            if (topErrorField === 'ltrRcptnYn'){
                $focusElement = $('#smsYes');
            }else{
                $focusElement = $(`[name="${topErrorField}"]`).length > 0 ? $(`[name="${topErrorField}"]`) : $(`#${topErrorField}`);
            }

            YTHIPcomm.alert({title: "필수항목 미입력 안내", msg: errorMessage }, $focusElement);
        }
    };

    /**
     * 단일 필드 검증 메서드
     * @param {string} field - 필드 이름
     * @param {*} value - 필드 값
     * @param {Object} [formData={}] - 폼 데이터 객체
     * @returns {Object} 검증 결과 객체
     * @private
     */
    const _validateField = function(field, value, formData = {}) {
        const rules = RULES[field]?.rules;
        if (!rules) return { isValid: true };
        for (let rule of rules) {
            if (!rule.test(value, formData)) {
                return { isValid: false, message: rule.message };
            }
        }
        return { isValid: true };
    };

    /**
     * 폼 전체 데이터 검증 메서드
     * @param {Object} formData - 폼 데이터 객체
     * @returns {Object} 폼 검증 결과
     * @private
     */
    const validateForm = function(formData) {
        const combinedFormData = { ..._form, ...formData };

        const errors = {};
        let topLevelField = null;
        let topLevelElement = null;

        for (let field in combinedFormData) {

            const $field = $(`[name="${field}"]`).length > 0 ? $(`[name="${field}"]`) : $(`#${field}`);
            let value;

            if ($field.is(':radio')) {
                // 라디오 버튼의 선택된 값만 가져옴
                value = $(`[name="${field}"]:checked`).val() || null;
            } else if ($field.is(':checkbox')) {
                // 체크박스는 여러 값의 배열로 반환
                value = $(`[name="${field}"]:checked`).map(function() {
                    return this.value;
                }).get();
            } else {
                // 일반 필드
                value = combinedFormData[field];
            }


            const result = _validateField(field, value, combinedFormData);

            if (!result.isValid) {
                errors[field] = result.message;

                // 에러 스타일 적용
                if ($field.is(':radio') || $field.is(':checkbox')) {
                    applyFieldErrorStyle($field.closest('.checks')); // 상위 컨테이너에 스타일 적용
                } else {
                    applyFieldErrorStyle($field); // 일반 필드에 스타일 적용
                }

                // 최상위 요소 결정
                const currentTopLevel = $field.closest('.checks, ul, div, form'); // 상위 요소 탐색
                if (currentTopLevel.length > 0 && (!topLevelElement || currentTopLevel.offset().top < topLevelElement.offset().top)) {
                    topLevelField = field;
                    topLevelElement = currentTopLevel;
                }
            } else {
                // 에러가 없을 경우 스타일 제거
                if ($field.is(':radio') || $field.is(':checkbox')) {
                    removeFieldErrorStyle($field.closest('.checks'));
                } else {
                    removeFieldErrorStyle($field);
                }
            }
        }

        if (topLevelElement) {
            // 최상위 요소로 포커스 이동
            topLevelElement.attr('tabindex', -1).focus(); // tabindex를 추가하여 focus 가능하게 설정
        } else if (topLevelField) {
            // 상위 요소가 없을 경우 기본 필드로 포커스 이동
            const $firstField = $(`[name="${topLevelField}"]`).length > 0 ? $(`[name="${topLevelField}"]`) : $(`#${topLevelField}`);
            $firstField.focus();
        }

        return {
            isValid: Object.keys(errors).length === 0,
            errors,
            topLevelField,
        };
    };


    /**
     * 필드에 에러 스타일을 적용하는 함수
     * @param {jQuery} $field - 에러를 적용할 필드
     * @param {Object} borderStyle - 테두리 스타일 옵션
     * @private
     */
    const applyFieldErrorStyle = function($field) {
        if ($field.is(':radio') || $field.is(':checkbox')) {
            // radio/checkbox의 경우 상위 컨테이너에 클래스 추가
            $field.closest('.checks').addClass('is-error');
        } else {
            // 일반 필드의 경우 필드 자체에 클래스 추가
            $field.addClass('is-error');
        }
    };
    /**
     * 필드의 에러 스타일을 제거하는 함수
     * @param {jQuery} $field - 에러 스타일을 제거할 필드
     * @param {Object} borderStyle - 테두리 스타일 옵션
     * @private
     */
    const removeFieldErrorStyle = function($field) {
        if ($field.is(':radio') || $field.is(':checkbox')) {
            // radio/checkbox의 경우 상위 컨테이너에서 클래스 제거
            $field.closest('.checks').removeClass('is-error');
        } else {
            // 일반 필드의 경우 필드 자체에서 클래스 제거
            $field.removeClass('is-error');
        }
    };


