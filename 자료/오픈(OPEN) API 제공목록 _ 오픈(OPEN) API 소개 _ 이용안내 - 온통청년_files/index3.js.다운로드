			this.confirmModalCallback = callback;
			this.confirmModalOldValue = oldValue;
			this.showConfirmModal = true;
		},
		handleConfirmYes() {
			this.showConfirmModal = false;
			if (this.confirmModalCallback) {
				this.confirmModalCallback();
			}
