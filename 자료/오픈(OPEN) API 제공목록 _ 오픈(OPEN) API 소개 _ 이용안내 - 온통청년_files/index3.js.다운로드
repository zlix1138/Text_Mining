		scheduleVoiceScrollToBottom() {
			if (this.voiceScrollScheduled) {
				return;
			}
			this.voiceScrollScheduled = true;
			requestAnimationFrame(() => {
				this.voiceScrollScheduled = false;
				this.scrollToBottom();
			});
		},
		ensureVoiceStreamRenderer(messageId) {
			if (!messageId) {
				return null;
			}
			if (!this.voiceStreamRenderStateByMessage[messageId]) {
				this.voiceStreamRenderStateByMessage[messageId] = {
					targetText: '',
					timerId: null
				};
			}
			return this.voiceStreamRenderStateByMessage[messageId];
		},
		startVoiceStreamRenderer(messageId) {
			const state = this.ensureVoiceStreamRenderer(messageId);
			if (!state || state.timerId) {
				return;
			}
			state.timerId = setInterval(() => {
				const targetMessage = this.messageList.find((msg) => msg.id === messageId);
				if (!targetMessage) {
					this.stopVoiceStreamRenderer(messageId);
					return;
				}

				const targetText = state.targetText || '';
				const currentText = targetMessage.text_data || '';
				if (currentText === targetText) {
					if (targetMessage.isComplete) {
						this.stopVoiceStreamRenderer(messageId);
					}
					return;
				}

				if (targetText.length < currentText.length) {
					targetMessage.text_data = targetText;
					this.scheduleVoiceScrollToBottom();
					return;
				}

				const appendText = targetText.slice(
					currentText.length,
					currentText.length + Math.max(1, this.voiceStreamChunkSize)
				);
				targetMessage.text_data = currentText + appendText;
				this.scheduleVoiceScrollToBottom();
			}, Math.max(16, this.voiceStreamRenderIntervalMs));
		},
		setVoiceStreamTarget(messageId, text) {
			const state = this.ensureVoiceStreamRenderer(messageId);
			if (!state) {
				return;
			}
			state.targetText = text || '';
			this.startVoiceStreamRenderer(messageId);
		},
		stopVoiceStreamRenderer(messageId, flush = false) {
			const state = this.voiceStreamRenderStateByMessage[messageId];
			if (!state) {
				return;
			}
			if (state.timerId) {
				clearInterval(state.timerId);
				state.timerId = null;
			}
			if (flush) {
				const targetMessage = this.messageList.find((msg) => msg.id === messageId);
				if (targetMessage) {
					targetMessage.text_data = state.targetText || targetMessage.text_data || '';
				}
			}
			delete this.voiceStreamRenderStateByMessage[messageId];
		},
		clearAllVoiceStreamRenderers() {
			Object.keys(this.voiceStreamRenderStateByMessage).forEach((messageId) => {
				this.stopVoiceStreamRenderer(messageId, false);
			});
			this.voiceStreamRenderStateByMessage = {};
		},
		createVoiceTransientMessage(type, text = '') {
			const now = Date.now();
			return {
				id: `voice_${type}_${now}_${Math.random().toString(36).slice(2, 8)}`,
				type,
				text_data: text,
				created_at: dayjs().format('YYYY-MM-DD HH:mm:ss'),
				eva_type: null,
				eva_items: [],
				eva_comment: '',
				showDirectInput: false,
				showMainEvalPanel: false,
				isComplete: type === 'q',
				isVoiceTransient: true
			};
		},
		handleVoiceBridgeUserFinal(payload = {}) {
			const text = (payload.text || '').trim();
			if (!text) {
				return;
			}

			if (!this.hasAskedQuestion) {
				this.hasAskedQuestion = true;
			}

			const message = this.createVoiceTransientMessage('q', text);
			this.messageList.push(message);
			this.$nextTick(() => this.scheduleVoiceScrollToBottom());
		},
		handleVoiceBridgeAssistantPartial(payload = {}) {
			const responseId = payload.responseId || '';
			const text = payload.text || '';
			if (!responseId) {
				return;
			}

			let messageId = this.voiceBridgeAssistantMessageIdByResponse[responseId];
			let targetMessage = messageId
				? this.messageList.find((msg) => msg.id === messageId)
				: null;

			if (!targetMessage) {
				targetMessage = this.createVoiceTransientMessage('a', '');
				targetMessage.isComplete = false;
				targetMessage.voiceResponseId = responseId;
				this.messageList.push(targetMessage);
				this.voiceBridgeAssistantMessageIdByResponse[responseId] = targetMessage.id;
			}

			targetMessage.isComplete = false;
			this.setVoiceStreamTarget(targetMessage.id, text);
			this.$nextTick(() => this.scheduleVoiceScrollToBottom());
		},
		handleVoiceBridgeAssistantFinal(payload = {}) {
			const responseId = payload.responseId || '';
			if (!responseId) {
				return;
			}

			this.handleVoiceBridgeAssistantPartial(payload);
			const messageId = this.voiceBridgeAssistantMessageIdByResponse[responseId];
			const targetMessage = messageId
				? this.messageList.find((msg) => msg.id === messageId)
				: null;

			if (targetMessage) {
				const finalText = (payload.text || '').trim();
				if (finalText) {
					this.setVoiceStreamTarget(targetMessage.id, finalText);
				}
				targetMessage.isComplete = true;
			}
			this.$nextTick(() => this.scheduleVoiceScrollToBottom());
		},
		handleVoiceBridgeResponseDone(payload = {}) {
			const responseId = payload.responseId || '';
			if (!responseId) {
				return;
			}

			const messageId = this.voiceBridgeAssistantMessageIdByResponse[responseId];
			const targetMessage = messageId
				? this.messageList.find((msg) => msg.id === messageId)
				: null;

			if (targetMessage && !targetMessage.isComplete) {
				targetMessage.isComplete = true;
			}

			if (messageId) {
				this.stopVoiceStreamRenderer(messageId, true);
			}

			delete this.voiceBridgeAssistantMessageIdByResponse[responseId];
			this.$nextTick(() => this.scheduleVoiceScrollToBottom());
		},
		setVoiceToolStatus(text) {
			if (this.voiceToolStatusClearTimer) {
				clearTimeout(this.voiceToolStatusClearTimer);
				this.voiceToolStatusClearTimer = null;
			}
			this.voiceToolStatusText = text || '';
		},
		scheduleVoiceToolStatus(text, delayMs = 3000) {
			const nextText = text || '';
			if (!nextText) {
				return;
			}

			if (this.voiceToolStatusText) {
				this.setVoiceToolStatus(nextText);
				return;
			}

			this.voiceToolStatusPendingText = nextText;
			if (this.voiceToolStatusDelayTimer) {
				clearTimeout(this.voiceToolStatusDelayTimer);
			}
			this.voiceToolStatusDelayTimer = setTimeout(() => {
				this.voiceToolStatusDelayTimer = null;
				if (this.voiceToolStatusPendingText) {
					this.setVoiceToolStatus(this.voiceToolStatusPendingText);
				}
			}, Math.max(0, Number(delayMs) || 0));
		},
		clearVoiceToolStatus(delayMs = 0) {
			if (this.voiceToolStatusDelayTimer) {
				clearTimeout(this.voiceToolStatusDelayTimer);
				this.voiceToolStatusDelayTimer = null;
			}
			this.voiceToolStatusPendingText = '';

			if (this.voiceToolStatusClearTimer) {
				clearTimeout(this.voiceToolStatusClearTimer);
				this.voiceToolStatusClearTimer = null;
			}
			if (delayMs > 0) {
				this.voiceToolStatusClearTimer = setTimeout(() => {
					this.voiceToolStatusText = '';
					this.voiceToolStatusClearTimer = null;
				}, delayMs);
				return;
			}
			this.voiceToolStatusText = '';
		},
		handleVoiceRealtimeEvent(event) {
			const detail = event?.detail;
			if (!detail || typeof detail !== 'object') {
				return;
			}

			const raw = detail.raw || {};
			const eventType = detail.type || raw.type || '';
			if (eventType !== 'voice.tool.status') {
				return;
			}

			const state = raw.state || detail.state || '';
			const toolName = raw.tool_name || detail.tool_name || '';
			const message = (raw.message || detail.message || detail.text || '').trim();

			if (state === 'tool_running') {
				const fallback = toolName === 'search_web' ? '외부에서 찾는 중...' : '근거 찾는 중...';
				this.scheduleVoiceToolStatus(message || fallback, 3000);
				return;
			}

			if (state === 'answering') {
				if (this.voiceToolStatusText) {
					this.setVoiceToolStatus('답변 정리 중...');
				}
				return;
			}

			if (state === 'done') {
				this.clearVoiceToolStatus(400);
			}
		},
		stopAllTTS() {
			try {
				Object.values(this.ttsPlayers || {}).forEach(player => {
					if (player && typeof player.stop === 'function') {
