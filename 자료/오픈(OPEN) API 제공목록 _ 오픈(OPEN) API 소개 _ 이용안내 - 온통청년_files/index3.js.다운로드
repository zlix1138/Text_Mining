			this.voiceChatBridge = new window.VoiceChatBridge({
				partialThrottleMs: 80,
				persistDebounceMs: 3000,
				onUserFinal: (payload) => this.handleVoiceBridgeUserFinal(payload),
				onAssistantPartial: (payload) => this.handleVoiceBridgeAssistantPartial(payload),
				onAssistantFinal: (payload) => this.handleVoiceBridgeAssistantFinal(payload),
