	},
	methods: {
		updateFontColors() {
			if (this.chatColorAuto === 'off') {
				if (this.chatNameColor) {
					this.theme.header_title_color = 'color : ' + this.chatNameColor;
				}
				if (this.chatDescColor) {
					this.theme.header_desc_color = 'color : ' + this.chatDescColor;
				}
			}
		},
		// 펼침 설정 confirm modal 처리 함수
		showConfirmForExpand(message, newVal) {
			this.showConfirm(message, () => {
				const today = new Date();
				const expireTime = new Date(today.getFullYear(), today.getMonth(), today.getDate() + 1, 0, 0, 0, 0).getTime() - 1;
				
				// ✅ postMessage로 설정값 전달 (부모 창에서 localStorage 저장)
				const settingsData = {
					type: 'chatSettingsSave',
					chat_expand: newVal,
					chat_border: this.borderType === 'color' ? 'on' : 'off',
					chat_border_color: this.borderColor,
					chat_expand_expire: expireTime.toString()
				};
				
				if (window.parent && window.parent !== window) {
					window.parent.postMessage(settingsData, '*');
					window.parent.postMessage({ type: 'chatExpandChanged', value: newVal }, '*');
				} else if (window.opener) {
					window.opener.postMessage(settingsData, '*');
					window.opener.postMessage({ type: 'chatExpandChanged', value: newVal }, '*');
				}
			}, newVal === 'on' ? 'off' : 'on');
		},
		resolveVoiceRuntimeMode() {
			if (typeof window === 'undefined') {
				return 'webrtc';
			}
			const configuredMode = window.VOICE_RUNTIME_CONFIG && window.VOICE_RUNTIME_CONFIG.mode;
			return configuredMode === 'stt' ? 'stt' : 'webrtc';
		},
		closeWindow() {
			window.close();
			  const wbsbtn = document.getElementById('windowbs');
