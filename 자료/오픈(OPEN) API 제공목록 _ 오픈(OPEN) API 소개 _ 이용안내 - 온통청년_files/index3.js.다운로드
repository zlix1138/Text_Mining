			// 초기화 시점(isInitializing이 true 또는 oldVal이 undefined)에는 동작하지 않음
			if (this.isInitializing || oldVal === undefined) return;
			
			if (newVal !== oldVal) {
				if (this.isConfirming) {
					this.isConfirming = false;
					return;
				}
				
				const message = newVal === 'on' 
					? '채팅창 펼침 기능을 사용하시겠습니까?' 
					: '채팅창 펼침 기능을 미사용하시겠습니까?';
				
				this.isConfirming = true;
				this.showConfirmForExpand(message, newVal);
