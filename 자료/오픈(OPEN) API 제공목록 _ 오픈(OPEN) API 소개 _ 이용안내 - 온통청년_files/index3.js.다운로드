		// 다음 추천질문으로 이동
		nextRollingQuestion() {
		  if (this.isSliding) return;
		  const total = this.rollingQuestions.length;
		  if (total <= 1) return;

		  this.isSliding = true;
		  const target = this.currentRollingIndex + 1;

		  // 1. 애니메이션 ON 상태로 다음으로 이동
		  this.isTransitionDisabled = false;
		  this.currentRollingIndex = target;

		  // 2. 마지막에 도달하면 -> 애니메이션 끝난 후 점프
		  if (target >= total) {
			setTimeout(() => {
			  // ✅ 애니메이션을 끈 후 점프 (이것이 핵심)
			  this.isTransitionDisabled = true;
			  this.currentRollingIndex = 0;

			  // ✅ Vue가 DOM을 업데이트할 시간을 확보
			  setTimeout(() => {
				this.isTransitionDisabled = false;
			  }, 20);

			}, 300); // ✅ 애니메이션이 끝나는 0.3초 후 실행
		  }

		  // 3. 잠금 해제 & 타머 리셋
		  setTimeout(() => {
			this.isSliding = false;
			this.startMarqueeInterval();
		  }, 320);
		},

		// 이전 추천질문으로 이동
		prevRollingQuestion() {
		  if (this.isSliding) return;
		  const total = this.rollingQuestions.length;
		  if (total <= 1) return;

		  this.isSliding = true;
		  const target = this.currentRollingIndex - 1;

		  // 애니메이션 켜진 상태로 이동
		  this.isTransitionDisabled = false;
		  this.currentRollingIndex = target;

		  // 첫 페이지에서 앞으로 갈 때 → 뒤로 순간이동
		  if (target < 0) {
			setTimeout(() => {
			  // 애니메이션 끄고 순간이동
			  this.isTransitionDisabled = true;
			  this.currentRollingIndex = total - 1;

			  // Vue 렌더링 확보
			  setTimeout(() => {
				this.isTransitionDisabled = false;
			  }, 20);

			}, 300);
		  }

		  // 잠금 해제
		  setTimeout(() => {
			this.isSliding = false;
			this.startMarqueeInterval();
		  }, 320);
		},
