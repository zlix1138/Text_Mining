		adjustFontSize(action) {
			const step = 1;
			const min = 12;
			const max = 24;
			
			let newSize = this.currentFontSize;

			switch (action) {
				case 'l1':
					newSize = 12; 
					break;
				case 'l2':
					newSize = 15; 
					break;
				case 'l3':
					newSize = 18;
					break;
				case 'l4':
					newSize = 21; 
					break;
				case 'l5':
					newSize = 24;
					break;
				case 'decrease':
					newSize = Math.max(min, this.currentFontSize - step);
					break;
				case 'increase':
					newSize = Math.min(max, this.currentFontSize + step);
					break;
				default:
					newSize = this.currentFontSize;
			}
			
			this.currentFontSize = newSize; 
			this.updateFontSize(); 
		},

