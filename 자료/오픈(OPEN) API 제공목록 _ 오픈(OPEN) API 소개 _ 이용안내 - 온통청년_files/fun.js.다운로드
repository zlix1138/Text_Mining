$(document).keydown(function(e) {
    if ((e.ctrlKey || e.metaKey) && e.key === 'c' && window.getSelection().toString()) {
		// 焦点在 textarea 里，直接走浏览器默认复制，不执行自定义逻辑
		const activeEl = document.activeElement;
		if (activeEl.tagName === 'TEXTAREA') {
			return;
		}

        e.preventDefault();
        e.stopPropagation();

        var selection = window.getSelection();
        var range = selection.getRangeAt(0);
        var clonedContent = range.cloneContents();
        var $temp = $('<div style="position:absolute; top:-9999px;"></div>');
        $temp.append(clonedContent);
        
        // ===== 核心修复：第一步先全量删除所有已有 marker（杜绝重复）=====
        // 无论 marker 在 ul/ol 内还是单独 li 内，先删干净
        $temp.find('.iCon, .hidNunber').remove();

        // ===== 原有 marker 生成逻辑（保留，此时无重复）=====
        // 1. 处理有ul/ol的情况
        $temp.find('ol').each(function() {
            var $ol = $(this);
            $ol.children('li').each(function(index) {
                $(this).prepend("<i class='hidNunber'>" + (index + 1) + ".</i>");
            });
        });
        $temp.find('ul').each(function() {
            var $ul = $(this);
            $ul.children('li').each(function() {
                $(this).prepend("<i class='iCon'>&#8226;&nbsp;</i>");
            });
        });

        // 2. 处理单独li的情况
        $temp.find('li').each(function() {
            if (!$(this).find('.iCon').length && !$(this).find('.hidNunber').length) {
                var $parent = $(this).parent();
                if ($parent.is('ol') || $parent.hasClass('addquestionLong') && $parent[0].tagName === 'OL') {
                    $(this).prepend("<i class='hidNunber'>1.</i>");
                } else {
                    $(this).prepend("<i class='iCon'>&#8226;&nbsp;</i>");
                }
            }
        });

        // ===== 原有格式处理逻辑（全保留）=====
        $temp.find('*').addBack().each(function() {
            this.style.backgroundColor = 'transparent';
            this.style.background = 'none';
            $(this).css('background-color', '');
        });
        $temp.find('.iCon, .hidNunber').each(function() {
            var iconHtml = $(this).html().replace(/\n+/g, '').replace(/\s+/g, ' ');
            $(this).html(iconHtml);
            $(this).css('display', 'inline');
            if (this.nextSibling) {
                if (this.nextSibling.nodeType === 3) {
                    this.nextSibling.textContent = this.nextSibling.textContent.replace(/^\n+/g, '');
                } else if (this.nextSibling.nodeType === 1) {
                    $(this.nextSibling).css('display', 'inline');
                }
            }
        });
        $temp.find('*').addBack().contents().each(function() {
            if (this.nodeType === 3) {
                this.textContent = this.textContent.replace(/\n{2,}/g, '\n').trim();
            }
        });

        // ===== 复制逻辑（全保留）=====
        $('body').append($temp);
        var copyRange = document.createRange();
        copyRange.selectNodeContents($temp[0]);
        selection.removeAllRanges();
        selection.addRange(copyRange);
        var copySuccess = document.execCommand('copy');
        
        if (!copySuccess) {
            var finalText = $temp.text().replace(/•\s*\n+/g, '• ').replace(/\n{2,}/g, '\n').trim();
            var $textarea = $('<textarea style="position:absolute; top:-9999px;"></textarea>');
            $textarea.val(finalText);
            $('body').append($textarea);
            $textarea[0].select();
            document.execCommand('copy');
            $textarea.remove();
        }

        $temp.remove();
        selection.removeAllRanges();
        selection.addRange(range);
    }
});






