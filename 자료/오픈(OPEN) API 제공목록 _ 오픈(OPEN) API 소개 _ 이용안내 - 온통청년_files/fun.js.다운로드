window.autoResize = function (textarea) {
    // textarea 요소의 유효성 검사
    if (!textarea || !textarea.nodeType || textarea.tagName !== 'TEXTAREA') {
        console.warn('autoResize: 전달된 요소가 유효한 textarea가 아닙니다');
        return;
    }

    // sendMessagea 요소 가져오기 (writing 클래스 추가/제거용)
    const sendMessageEl = document.getElementById('sendMessagea');
    if (!sendMessageEl) {
        console.warn('autoResize: id가 sendMessagea인 요소를 찾을 수 없습니다');
    }

    // 1. writing 클래스 추가/제거 처리
    const isEmpty = textarea.value.trim().length === 0;
    if (sendMessageEl) {
        if (!isEmpty) {
            sendMessageEl.classList.add('writing');
        } else {
            sendMessageEl.classList.remove('writing');
        }
    }

    // 2. 높이 계산 로직 최적화: 1줄을 초과한 경우에만 높이 증가
    if (isEmpty) {
        textarea.style.removeProperty('height');
        textarea.style.overflow = 'hidden';
    } else {
        const computedStyle = getComputedStyle(textarea);

        // line-height 파싱 (NaN 예외 처리 포함)
        let lineHeight = parseInt(computedStyle.lineHeight);
        if (isNaN(lineHeight)) {
            lineHeight = parseInt(computedStyle.fontSize) || 22;
            console.warn('autoResize: line-height를 가져올 수 없어 font-size를 기본값으로 사용합니다');
        }

        const maxHeight = lineHeight * 10; // 최대 높이 제한 (10줄)

        // [핵심 최적화 1] 숨겨진 테스트 요소를 생성하여 실제로 1줄을 초과하는지 정확히 판단
        const testDiv = document.createElement('div');

        // textarea와 동일한 주요 스타일을 복사 (너비, 폰트, 줄간격 등 동일하게 유지)
        testDiv.style.position = 'absolute';
        testDiv.style.visibility = 'hidden';
        testDiv.style.whiteSpace = 'pre-wrap'; // 줄바꿈 및 공백 유지
        testDiv.style.wordWrap = 'break-word'; // 자동 줄바꿈
        testDiv.style.width = computedStyle.width;
        testDiv.style.fontSize = computedStyle.fontSize;
        testDiv.style.fontFamily = computedStyle.fontFamily;
        testDiv.style.lineHeight = computedStyle.lineHeight;
        testDiv.style.padding = computedStyle.padding;
        testDiv.style.boxSizing = computedStyle.boxSizing;

        // 현재 textarea의 텍스트 내용을 복사
        testDiv.textContent = textarea.value;
        document.body.appendChild(testDiv);

        // [핵심 최적화 2] 테스트 요소의 높이를 측정하여 1줄 초과 여부 판단
        const testDivHeight = testDiv.offsetHeight;
        const paddingTop = parseInt(computedStyle.paddingTop) || 0;
        const paddingBottom = parseInt(computedStyle.paddingBottom) || 0;
        const singleLineTotalHeight = paddingTop + paddingBottom + lineHeight;

        // 테스트 요소 제거
        document.body.removeChild(testDiv);

        // [핵심 최적화 3] 테스트 높이가 1줄 전체 높이보다 클 때만 다중 줄 처리
        let finalHeight;
        if (testDivHeight <= singleLineTotalHeight) {
            // 엄격하게 1줄 높이 유지
            finalHeight = lineHeight;
        } else {
            // 1줄을 초과하면 실제 콘텐츠 높이 사용
            textarea.style.height = '0px';
            textarea.style.height = 'auto';
            const contentHeight = textarea.scrollHeight - paddingTop - paddingBottom;
            finalHeight = contentHeight;
        }

        // 최대 높이 제한 적용
        if (finalHeight <= maxHeight) {
            textarea.style.height = (finalHeight + paddingTop + paddingBottom) + 'px';
            textarea.style.overflow = 'hidden';
        } else {
            textarea.style.height = maxHeight + 'px';
            textarea.style.overflow = 'auto';
        }
    }

    // 3. 글자 수 제한 경고 로직 (기존 로직 유지)
    const maxLengthAttr = textarea.getAttribute('maxlength');
    if (!maxLengthAttr) {
        console.debug('autoResize: textarea에 maxlength 속성이 설정되어 있지 않습니다');
        return;
    }

    const maxLength = parseInt(maxLengthAttr);
    if (isNaN(maxLength)) {
        console.warn(`autoResize: maxlength 속성값 "${maxLengthAttr}"가 유효한 숫자가 아닙니다`);
        return;
    }

    const currentLength = textarea.value.length;
    const warningElement = document.getElementById('charLimitWarning');
    if (!warningElement) {
        console.warn('autoResize: id가 charLimitWarning인 경고 요소를 찾을 수 없습니다');
        return;
    }

    // 기존 타이머가 있으면 제거
    if (window.charLimitTimer) {
        clearTimeout(window.charLimitTimer);
    }

    // 글자 수 초과 경고 처리
    if (currentLength >= maxLength) {
        const maxLengthFormatted = Number(maxLength).toLocaleString();
        warningElement.textContent = `⚠ 입력 가능한 최대 글자 수 ${maxLengthFormatted}개를 초과했습니다. `;
        warningElement.style.opacity = '1';
        warningElement.style.transition = 'opacity 0.3s';

        window.charLimitTimer = setTimeout(() => {
            warningElement.style.opacity = '0';
        }, 3000);
    } else {
        warningElement.style.opacity = '0';
    }
};

// -------------- 사용 예시 --------------
const initTextareaAutoResize = function() {
    const textareaEl = document.querySelector('textarea');
    if (textareaEl) {
        // 기존에 바인딩된 이벤트 제거 (중복 방지)
        textareaEl.removeEventListener('input', () => autoResize(textareaEl));

        // input 이벤트 재바인딩
        textareaEl.addEventListener('input', function() {
            autoResize(this);
        });

        // 초기 로딩 시 한 번 실행
        autoResize(textareaEl);
    }
};

