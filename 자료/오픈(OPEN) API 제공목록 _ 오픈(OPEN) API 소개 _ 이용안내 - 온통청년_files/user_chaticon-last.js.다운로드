			let popupUrl = isLocal 
				? `${location.href.substring(0, location.href.lastIndexOf('/'))}/_ai_/chat.html?chatID=${chatID}${borderParam}${borderColorParam}` 
				: `${(iconSettings?.siteBasePath || '').replace(/\/+$/, '')}/_ai_/chat.html?chatID=${chatID}${borderParam}${borderColorParam}`;
			chatPopup = window.open(popupUrl, 'chatPopup', `${popupSize},scrollbars=no,resizable=yes,status=no,toolbar=no,menubar=no`);
		};


		// 이벤트 리스너 등록 (한 번만)
		openLink.addEventListener('click', (e) => {
			e.preventDefault();
			e.stopPropagation();
			if (!chatPopup || chatPopup.closed) openChatPopup(); else chatPopup.focus();
		});

		closeLink.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); timeBox.style.display = timeBox.style.display === 'none' ? 'flex' : 'none'; });
		timeCloseLink.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); timeBox.style.display = 'none'; });
		timeCheckbox.addEventListener('change', (e) => { if (e.target.checked) { setCookie('chat_icon_hide_time', '24', 24); container.style.display = 'none'; } });
		container.addEventListener('mouseenter', () => { if (settingsLoaded && iconSettings.chat_balloon === 'on') balloonBox.style.display = 'block'; });
		container.addEventListener('mouseleave', () => { balloonBox.style.display = 'none'; });

		// ✅ 수정된 드래그 시작 함수 (✅ 수정된 드래그 시작 함수)
		const handleDragStart = (e) => {
			if (!iconSettings || iconSettings.chat_drag_icon_use !== 'on') return;
			e.preventDefault();
			e.stopPropagation();

			isDragging = true;
			startX = e.clientX;
			startY = e.clientY;

			// 현재 위치 기록 (현재 위치 기록)
			const rect = container.getBoundingClientRect();
			const winW = window.innerWidth;
			const winH = window.innerHeight;

			startRight = winW - rect.right;
			startBottom = winH - rect.bottom;

			// top 고정 상태 기록 (top 고정 상태 기록)
			dragStartTopFixed = (container.style.top !== '' && container.style.top !== 'auto');
			if (dragStartTopFixed) {
				dragStartTopValue = parseInt(container.style.top);
			}

			document.body.style.cursor = 'grabbing';
		};

		// ✅ 수정된 드래그 이동 함수 (✅ 수정된 드래그 이동 함수)
		const handleDragMove = (e) => {
			if (!isDragging) return;
			e.preventDefault();

			const deltaX = e.clientX - startX;
			const deltaY = e.clientY - startY;

			// top 고정 상태인 경우 (top 고정 상태인 경우)
			if (dragStartTopFixed) {
				// 명확한 아래쪽 드래그인지 확인 (아래로 50px 이상 이동, 수직 이동이 수평 이동보다 큰 경우) (명확한 아래쪽 드래그인지 확인 - 아래로 50px 이상 이동, 수직 이동이 수평 이동보다 큰 경우)
				const isIntentionalDown = deltaY > 50 && Math.abs(deltaY) > Math.abs(deltaX);

				// 명확한 아래쪽 드래그: top 고정 해제 (명확한 아래쪽 드래그: top 고정 해제)
				if (isIntentionalDown) {
					// 해제 표시만 하고 즉시 스타일을 설정하지 않음 - 아래 정상 드래그 로직이 처리하도록 함 (해제 표시만 하고 즉시 스타일을 설정하지 않음 - 아래 정상 드래그 로직이 처리하도록 함)
					dragStartTopFixed = false;
					// 참고: 여기서 container.style.top과 bottom을 설정하지 않음 (참고: 여기서 container.style.top과 bottom을 설정하지 않음)
					// 아래 코드에서 통합 처리됨 (아래 코드에서 통합 처리됨)
				} else {
					// 다른 경우 (위쪽, 손떨림, 좌우): 좌우만 이동 (다른 경우 - 위쪽, 손떨림, 좌우: 좌우만 이동)
					let newRight = startRight - deltaX;
					const winW = window.innerWidth;
					const w = container.offsetWidth || 70;
					newRight = Math.max(20, Math.min(newRight, winW - w - 20));
					container.style.right = newRight + 'px';
					// top과 bottom은 유지 (top과 bottom은 유지)
					return;
				}
			}

			// 정상 드래그 계산 (top 고정 해제된 경우 포함) (정상 드래그 계산 - top 고정 해제된 경우 포함)
			let newRight = startRight - deltaX;
			let newBottom = startBottom - deltaY;

			const winW = window.innerWidth;
			const winH = window.innerHeight;
			const w = container.offsetWidth || 70;
			const h = container.offsetHeight || 70;

			newRight = Math.max(20, Math.min(newRight, winW - w - 20));
			const maxBottom = winH - h - 45;
			newBottom = Math.max(0, Math.min(newBottom, maxBottom));

			container.style.right = newRight + 'px';
			container.style.bottom = newBottom + 'px';

			// 이전에 top 고정 상태였고 지금 해제된 경우 top을 auto로 설정 (이전에 top 고정 상태였고 지금 해제된 경우 top을 auto로 설정)
			if (dragStartTopFixed === false && container.style.top !== 'auto') {
				container.style.top = 'auto';
			}
		};

		// ✅ 수정된 드래그 종료 함수 (✅ 수정된 드래그 종료 함수)
		const handleDragEnd = () => {
			if (!isDragging) return;

			isDragging = false;
			document.body.style.cursor = '';

			// top 고정 상태가 아닌 경우에만 위치 저장 (top 고정 상태가 아닌 경우에만 위치 저장)
			if (!dragStartTopFixed) {
				const finalRight = parseInt(container.style.right);
				const finalBottom = parseInt(container.style.bottom);
				if (!isNaN(finalRight) && !isNaN(finalBottom)) {
					originalBottom = finalBottom + 'px';
					try {
						localStorage.setItem('chat_widget_pos', JSON.stringify({
							right: finalRight,
							bottom: finalBottom
						}));
						localStorage.setItem('chat_float_pos', JSON.stringify({
							right: finalRight + 'px',
							bottom: finalBottom + 'px'
						}));
					} catch (e) {}
				}
			}

			// top 고정 필요 여부 다시 확인 (top 고정 필요 여부 다시 확인)
			setTimeout(() => {
				fixWidgetInView(container, dragArea, false);
			}, 10);
		};

		// 리사이즈 이벤트 (리사이즈 이벤트)
		let resizeTimer;
		window.addEventListener('resize', () => {
			clearTimeout(resizeTimer);
			resizeTimer = setTimeout(() => {
				fixWidgetInView(container, dragArea, isDragging);
			}, 120);
		});

		dragArea.addEventListener('mousedown', handleDragStart);
		document.addEventListener('mousemove', handleDragMove);
		document.addEventListener('mouseup', handleDragEnd);
		document.addEventListener('mouseleave', handleDragEnd);

		chatWidgetElements = {
			container, openLink, iconImg, balloonBox, balloonText,
			closeBox, closeLink, closeImg, timeBox, timeCheckbox,
			timeLabel, timeCloseLink, timeCloseImg, dragArea, dragIcon
		};
	}

	// 설정 로드
	try {
		if (!isSettingsLoading && !isSettingsLoaded) {
			isSettingsLoading = true;
			const script = document.createElement('script');
			script.src = `${chatURL}/chat/chatDataLoader.php?chatID=${chatID}&callback=${iconSettingsCallback}`;
			script.type = 'text/javascript';
			script.onload = function() { isSettingsLoading = false; isSettingsLoaded = true; try { document.head.removeChild(script); } catch(e){} };
			script.onerror = function() { isSettingsLoading = false; try { document.head.removeChild(script); } catch(e){} if (!settingsLoaded) { if (!isStylesAdded) addChatWidgetStyles(); if (!isWidgetCreated) createChatWidget(); applyIconSettings(iconSettings); settingsLoaded = true; } };
			document.head.appendChild(script);
		}
	} catch (error) {
		isSettingsLoading = false;
		if (!settingsLoaded) { if (!isStylesAdded) addChatWidgetStyles(); if (!isWidgetCreated) createChatWidget(); applyIconSettings(iconSettings); settingsLoaded = true; }
	}

	function applyIconSettings(settings) {
		if (!chatWidgetElements) return;
		const { container, openLink, iconImg, balloonBox, balloonText, closeBox, dragArea, dragIcon } = chatWidgetElements;
		const isMobile = isMobileDevice();

		// 모바일 환경에서 mcoi 설정 확인
		if (isMobile && settings.mcoi === 'off') {
			openLink.style.display = 'none';
			return;
		}

		openLink.style.display = settings.coi === 'on' ? 'block' : 'none';
		
		// 모바일 여닫기 아이콘 설정 적용
		if (isMobile && settings.mcoi === 'on' && settings?.chat_mobile_oc_icon?.trim()) {
			iconImg.src = `${chatURL}/chat/uploaded_files/${settings.chat_mobile_oc_icon}`;
		} else {
			iconImg.src = (settings?.chat_oc_icon?.trim()) ? `${chatURL}/chat/uploaded_files/${settings.chat_oc_icon}` : `${chatURL}/chat/images/sub/k_open.png`;
		}
		
		iconImg.alt = settings?.chat_oc_icon_alt || '';

		// 모바일 아이콘 크기 설정 적용
		if (isMobile && settings.mcoi === 'on') {
			if (settings.chat_mobile_oc_icon_size_type === '2') {
				if (settings.chat_mobile_oc_icon_width) openLink.style.width = settings.chat_mobile_oc_icon_width + 'px';
				if (settings.chat_mobile_oc_icon_height) openLink.style.height = settings.chat_mobile_oc_icon_height + 'px';
			} else {
				openLink.style.width = '';
				openLink.style.height = '';
			}
		} else if (settings.chat_oc_icon_size_type === '2') {
			if (settings.chat_oc_icon_width) openLink.style.width = settings.chat_oc_icon_width + 'px';
			if (settings.chat_oc_icon_height) openLink.style.height = settings.chat_oc_icon_height + 'px';
		} else {
			openLink.style.width = '';
			openLink.style.height = '';
		}

		if (settings.chat_drag_icon_init === 'on') {
			if (settings.chat_drag_icon_init_x) container.style.right = settings.chat_drag_icon_init_x + 'px';
			if (settings.chat_drag_icon_init_y) container.style.bottom = settings.chat_drag_icon_init_y + 'px';
			originalBottom = container.style.bottom;
		}

		if (settings.chat_balloon === 'on' && settings.chat_balloon_text) {
			const textWithLineBreaks = settings.chat_balloon_text.replace(/\\n/g, '\n');
			balloonText.textContent = textWithLineBreaks;
			if (settings.chat_balloon_font_family) balloonText.style.fontFamily = settings.chat_balloon_font_family + ', Malgun Gothic'; else balloonText.style.fontFamily = 'Malgun Gothic';
			if (settings.chat_balloon_font_size) balloonText.style.fontSize = settings.chat_balloon_font_size;
			if (settings.chat_balloon_foreground_color) balloonText.style.color = settings.chat_balloon_foreground_color;
			if (settings.chat_balloon_background_color) balloonText.style.backgroundColor = settings.chat_balloon_background_color;
			balloonBox.style.display = 'none';
		} else { balloonBox.style.display = 'none'; }

		closeBox.style.display = settings.chat_oc_icon_close === 'on' ? 'flex' : 'none';

		if (settings.chat_drag_icon_use === 'on') {
			if (settings.chat_drag_icon) { dragIcon.src = `${chatURL}/chat/uploaded_files/${settings.chat_drag_icon}`; dragIcon.style.display = 'inline-block'; dragArea.className = 'touches icon'; }
			else { dragIcon.style.display = 'none'; dragArea.className = 'touches no-drag-icon'; }
		} else { dragIcon.style.display = 'none'; dragArea.style.display = 'none'; dragArea.className = 'touches no'; }

		if (!dragArea.classList.contains('no')) { container.style.minWidth = '76px'; container.style.paddingRight = '0px'; } else { closeBox.style.left = '100%'; }

		try {
			const saved = localStorage.getItem('chat_widget_pos');
			if (saved) { const pos = JSON.parse(saved); container.style.right = pos.right + 'px'; container.style.bottom = pos.bottom + 'px'; originalBottom = container.style.bottom; }
		} catch (e) {}

		const hasCloseBoxClass = closeBox.classList.contains('chbClose');
		const hasNoClass = dragArea.classList.contains('no');


		if (hasCloseBoxClass && !hasNoClass) {
			dragArea.style.left = '50%';
		} else {
			dragArea.style.left = '50%';
		}


		// 초기 위치 조정 (초기 위치 조정)
		setTimeout(() => {
			if (chatWidgetElements) {
				fixWidgetInView(container, dragArea, false);
			}
		}, 10);
	}

	// postMessage 리스너
	window.addEventListener('message', function(e) {
		// debug 로그
		console.log('[user_chaticon-last.js] 메시지 수신:', e.origin, e.data);

		// 출처 확인 조건 완화 - 모든 출처에서 수신 (개발/운영 환경 대응)
		// if (!chatURL || !e.origin.includes(chatURL.replace('http://', '').replace('https://', ''))) {
		//     console.log('무시된 메시지:', e.origin);
		//     return;
		// }

		if (e.data && e.data.type === 'chatExpandChanged') {
			const newChatExpand = e.data.value;
			
			// chat_expand='on'인 경우: last2.js 제거 후 last.js 재로드 (popup 모드로 전환)
			if (newChatExpand === 'on' && isLast2ScriptLoaded) {
				console.log('[user_chaticon-last.js] chat_expand=on으로 변경 - popup 모드로 전환');
				fullResetToPopupMode();
				lastChatExpand = newChatExpand;
				return;
			}
			console.log('[user_chaticon-last.js] chatExpandChanged 수신:', newChatExpand);

			// 스크립트 로드/제거
			if (newChatExpand === 'off') {
				// last2.js 로드
				if (!isLast2ScriptLoaded) {
					console.log('[user_chaticon-last.js] last2.js 로드 시도');
					loadLast2Script();
				} else {
					console.log('[user_chaticon-last.js] last2.js 이미 로드됨');
				}
			} else {
				// last2.js 제거
				console.log('[user_chaticon-last.js] last2.js 제거 시도');
				unloadLast2Script();
			}

			lastChatExpand = newChatExpand;
		}
		
		// chatSettingsSave 처리 (사용자 도메인 localStorage에 저장)
		if (e.data && e.data.type === 'chatSettingsSave') {
			console.log('[user_chaticon-last.js] chatSettingsSave 수신:', e.data);
			
			// 사용자 도메인 localStorage에 저장
			localStorage.setItem('chat_expand', e.data.chat_expand);
			localStorage.setItem('chat_border', e.data.chat_border);
			localStorage.setItem('chat_border_color', e.data.chat_border_color);
			localStorage.setItem('chat_expand_expire', e.data.chat_expand_expire);
			
			lastChatExpand = e.data.chat_expand;
		}
	});
})();
