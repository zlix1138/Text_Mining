// ✅ 수정된 fixWidgetInView 함수 (✅ 수정된 fixWidgetInView 함수)
function fixWidgetInView(container, dragArea, isDragging) {
	if (!container || isFixing) return;

	// 드래그 중이면 아무 작업도 하지 않음 (드래그 중이면 아무 작업도 하지 않음)
	if (isDragging) return;

	isFixing = true;

	const rect = container.getBoundingClientRect();
	const hasNoClass = dragArea.classList.contains('no');

	// touches에 no 클래스가 없을 때 top = 40px, 있을 때 top = 0px (touches에 no 클래스가 없을 때 top = 40px, 있을 때 top = 0px)
	const topLimit = !hasNoClass ? 40 : 0;

	// 현재 top 값이 설정되어 있는지 확인 (현재 top 값이 설정되어 있는지 확인)
	const isTopSet = container.style.top !== '' && container.style.top !== 'auto';

	// top이 limit보다 작거나 같은 경우 (top이 limit보다 작거나 같은 경우)
	if (rect.top <= topLimit) {
		// top 값 고정 (bottom은 auto로) (top 값 고정 - bottom은 auto로)
		if (!isTopSet || parseInt(container.style.top) !== topLimit) {
			container.style.top = topLimit + 'px';
			container.style.bottom = 'auto';
		}
	} else {
		// top 값이 limit 이상이고, 이전에 top이 설정되어 있었다면 해제 (top 값이 limit 이상이고, 이전에 top이 설정되어 있었다면 해제)
		if (isTopSet) {
			container.style.top = 'auto';
			if (originalBottom !== null && originalBottom !== 'auto') {
				container.style.bottom = originalBottom;
			}
		}
	}

	isFixing = false;
}

