// 상태 관리 변수들 (클로저 내에서만 사용)
var isWidgetCreated = false;
var isStylesAdded = false;
var isSettingsLoading = false;
var isSettingsLoaded = false;
var isLast2ScriptLoading = false;
var isLast2ScriptLoaded = false;
var chatWidgetElements = null;
var last2ScriptElement = null;
var lastChatExpand = null;

// last2.js 로드 함수 (최상단에 배치하여 함수 호이스팅 보장)
function loadLast2Script() {
	if (isLast2ScriptLoading || isLast2ScriptLoaded) return;
	if (last2ScriptElement) {
		console.log('last2.js가 이미 로드됨');
		return;
	}

    const lastJsPos = localStorage.getItem('chat_widget_pos');
    if (lastJsPos) {
        try {
            const pos = JSON.parse(lastJsPos);
            //last2.js 형식으로 변환 (문자열에 px 포함)
            if (pos.right !== undefined && pos.bottom !== undefined) {
                const migratedPos = {
                    right: pos.right + 'px',
                    bottom: pos.bottom + 'px'
                };
                // last2.js에 저장할 키 이름
                localStorage.setItem('chat_float_pos', JSON.stringify(migratedPos));
                console.log('[이동] last.js 위치 → last2.js:', migratedPos);
            }
        } catch(e) {
            console.error('[이동] 위치 정보 파싱 실패:', e);
        }
    } else {
        // 저장된 위치가 없으면 last2.js의 기존 위치를 읽어보기
        const last2Pos = localStorage.getItem('chat_float_pos');
        if (last2Pos) {
            console.log('[이동] last2.js 기존 위치 유지:', last2Pos);
        }
    }
    // ===== 이동끝 =====


	// 기존 아이콘 제거 (중복 방지)
	const existingWidgets = document.querySelectorAll('.chat-widget');
	existingWidgets.forEach(widget => {
		console.log('[user_chaticon-last.js] 기존 chat-widget 제거');
		widget.remove();
	});
	chatWidgetElements = null;
	isWidgetCreated = false;

	isLast2ScriptLoading = true;
	const script2 = document.createElement('script');
	script2.src = `${chatURL}/chat/js/user_chaticon-last2.js`;
	script2.type = 'text/javascript';
	script2.onload = function() {
		isLast2ScriptLoading = false;
		isLast2ScriptLoaded = true;
		last2ScriptElement = script2;
		console.log('user_chaticon-last2.js 로드 완료');
	};
	script2.onerror = function() {
		isLast2ScriptLoading = false;
		console.error('user_chaticon-last2.js 로드 실패');
	};
	document.head.appendChild(script2);
}

// last2.js 제거 함수 (loadLast2Script와 함께 최상단에 배치)
// Promise를 반환하여 제거 완료 후 다음 작업을 할 수 있음
function unloadLast2Script() {
	return new Promise((resolve) => {
		if (!isLast2ScriptLoaded || !last2ScriptElement) {
			resolve();
			return;
		}

		// 1. last2.js에 의해 생성된 DOM 요소 제거
		const chatWidgets = document.querySelectorAll('.chat-widget');
		chatWidgets.forEach(widget => {
			// iframe이 있는 widget만 제거 (last2.js에서 생성한 것)
			if (widget.querySelector('iframe')) {
				widget.remove();
			}
		});

		// 2. touches, borderss, chbClose 등 last2.js에서 생성한 요소 제거
		const touches = document.querySelectorAll('.touches');
		touches.forEach(el => el.remove());

		const borderss = document.querySelectorAll('.borderss');
		borderss.forEach(el => el.remove());

		const chbClose = document.querySelectorAll('.chbClose');
		chbClose.forEach(el => el.remove());

		const chatIconTalk = document.querySelectorAll('.chat-icon-talk');
		chatIconTalk.forEach(el => el.remove());

		const fakeChatIcon = document.getElementById('fake-chatIcon');
		if (fakeChatIcon) fakeChatIcon.remove();

		// 3. last2.js에 의해 등록된 이벤트 리스너 제거
		// last2.js에서 window.addEventListener('message', ...)로 등록한 이벤트는
		// 특정 handler를 알지 못하므로, message 이벤트를 재등록하여 오버라이드

		// 4. 스크립트 제거
		try {
			if (last2ScriptElement.parentNode === document.head) {
				document.head.removeChild(last2ScriptElement);
			}
		} catch (e) {}

		last2ScriptElement = null;
		isLast2ScriptLoaded = false;
		isLast2ScriptLoading = false;
		console.log('[user_chaticon-last.js] user_chaticon-last2.js 제거 완료');
		
		setTimeout(resolve, 100); // DOM이 완전히 제거될 시간을 주고 resolve
	});
}

// last.js를 다시 로드하는 함수 (Promise 반환)
function reloadLastScript() {
	return new Promise((resolve, reject) => {

		// 모든 last.js 제거
		document.querySelectorAll('script[src*="user_chaticon-last.js"]')
			.forEach(el => el.remove());

		const script = document.createElement('script');

		script.type = 'text/javascript';
		script.src = `${window.chatURL || chatURL}/chat/js/user_chaticon-last.js?reload=${Date.now()}`;
		script.async = true;

		script.onload = () => {
			console.log('[user_chaticon-last.js] user_chaticon-last.js 재로드 완료');
			resolve();
		};

		script.onerror = reject;

		document.head.appendChild(script);
	});
}

// fullReset: last2.js 제거 후 last.js 재로드
function fullResetToPopupMode() {
	return new Promise(async (resolve) => {
		try {
			await unloadLast2Script();
			// last.js 재로드는 현재 스크립트가 실행 중이므로 setTimeout으로 비동기 실행
			setTimeout(() => {
				reloadLastScript().then(resolve).catch(() => resolve());
			}, 150);
		} catch (e) {
			console.error('[user_chaticon-last.js] fullResetToPopupMode 실패:', e);
			resolve();
		}
	});
}

// localStorage 만료 체크
function checkLocalStorageAndLoad() {
	const savedChatExpand = localStorage.getItem('chat_expand');
	const expireTime = localStorage.getItem('chat_expand_expire');
	
	// chat_expand가 저장되어 있고, expire가 설정되어 있지 않거나 아직 만료되지 않은 경우
	const hasValidSetting = savedChatExpand && (
		!expireTime || Date.now() <= parseInt(expireTime)
	);
	
	if (hasValidSetting) {
		lastChatExpand = savedChatExpand;
		
		// chat_expand가 'off'이면 last2.js 즉시 로드
		if (lastChatExpand === 'off' && !isLast2ScriptLoaded) {
			console.log('[user_chaticon-last.js] localStorage에 chat_expand=off 저장됨, last2.js 즉시 로드');
			loadLast2Script();
		}
	}
}

// DOM이 이미 로드된 경우 즉시 실행, 아니면 DOMContentLoaded 이벤트 기다리기
// checkLocalStorageAndLoad()를 동기적으로 실행하여 isLast2ScriptLoading 플래그가 먼저 설정되도록 함
if (document.readyState === 'loading') {
	document.addEventListener('DOMContentLoaded', checkLocalStorageAndLoad);
} else {
	// loadLast2Script 함수가 정의될 때까지 대기
	const waitForLoadLast2Script = () => {
		if (typeof loadLast2Script === 'function') {
			checkLocalStorageAndLoad();
		} else {
			setTimeout(waitForLoadLast2Script, 10);
		}
	};
	waitForLoadLast2Script();
}

