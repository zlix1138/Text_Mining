// 랜덤 콜백 이름 생성 함수 (랜덤 콜백 이름 생성 함수)
function generateCallbackName() {
	return 'chatCallback_' + Math.random().toString(36).substr(2, 9) + '_' + Date.now();
}

// 서버 상태 확인 (chatDataLoader.php 사용)
async function checkServerStatus() {
	return new Promise((resolve) => {
		try {
			// script 태그 생성
			const script = document.createElement('script');
			const callbackName = generateCallbackName();
			script.src = `${chatURL}/chat/chatDataLoader.php?chatID=${chatID}&callback=${callbackName}`;
			script.type = 'text/javascript';

			const removeScript = () => {
				try { if (script.parentNode === document.head) document.head.removeChild(script); } catch (e) {}
			};

			window[callbackName] = function() { resolve(true); removeScript(); delete window[callbackName]; };
			script.onload = function() { if (typeof window[callbackName] === 'function') window[callbackName](); else { resolve(true); removeScript(); } };
			script.onerror = function() { resolve(true); removeScript(); delete window[callbackName]; };
			document.head.appendChild(script);
		} catch (error) { resolve(true); }
	});
}

// 쿠키 관련 함수
function setCookie(name, value, hours) {
	const date = new Date();
	date.setHours(23, 59, 59, 999);
	const expires = date.toUTCString();
	document.cookie = `${name}=${value}; expires=${expires}; path=/`;
}
function getCookie(name) {
	const encodedName = encodeURIComponent(name) + '=';
	const cookies = document.cookie.split(';');
	for (let i = 0; i < cookies.length; i++) {
		let cookie = cookies[i].trim();
		if (cookie.indexOf(encodedName) === 0) return decodeURIComponent(cookie.substring(encodedName.length));
	}
	return null;
}

