        const _logout = async function (target) {
            const url = `${YTHIPcomm.API_FRT_URL}/oauth/logout`;
            const headers = {
                "Content-Type": "application/json" // JSON으로 Content-Type 설정
            };

            if (!target || target == "") {
                target = "/main"
            }
            try {
                const response = await _promiseWithHeaders("POST", url, {}, headers);
                if (response.status == 200) {
                    // updateHeader();
                    if (response.data.ssoLogoutFlag == "Y") {
                        YTHIPbiz_auth.anyidAdaptor.ssoLogout(target);
                    } else {
                        location.href = target
                    }
                }
            } catch (error) {
                console.error("로그인 실패:", error);
                return error;
            }
        };

