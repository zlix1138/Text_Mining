            }
        };


        /**
         * 토큰을 디코딩하는 함수
         * @param {string} token - 디코딩할 JWT 토큰
         * @returns {object|null}
         * @private
         */
        const _decodeToken = function (token) {
            if (!token) {
                console.error("토큰이 존재하지 않습니다.");
                return null;
            }

            try {
                const parts = token.split('.');
                if (parts.length !== 3) {
                    console.error("유효하지 않은 토큰 형식입니다. 전달된 토큰:", token);
                    return null;
                }

                const payloadBase64Url = parts[1]; // 페이로드 부분 추출
                const payload = JSON.parse(_base64UrlDecode(payloadBase64Url)); // 디코딩 및 JSON 변환
                //console.log("디코드된 페이로드:", payload); // 디코드된 payload 출력
                return payload;
            } catch (error) {
                console.error("토큰 디코딩 중 오류 발생:", error);
                return null;
            }
        };

        /**
         * 토큰의 유효 시간 확인
         * @param {string} token - 유효 시간을 확인할 JWT 토큰
         * @returns {string} yyyyMMddHHmmss
         * @private
         */
        const _printTokenExpiry = function (token) {
            const decodedToken = _decodeToken(token);
            if (!decodedToken) {
                console.error("토큰이 유효하지 않습니다.");
                return;
            }

            const expiryTime = new Date(decodedToken.exp * 1000);
            //console.log("토큰 만료 시간:", expiryTime.toLocaleString());

            // yyyymmddhhmmss 형식으로 포맷된 만료 시간
            const formattedExpiryTime = _formatDateToYyyyMMddHHmmss(expiryTime);
            //console.log("포맷된 토큰 만료 시간:", formattedExpiryTime);
            return formattedExpiryTime;
        };

        /**
         * 토큰 만료 시간까지 남은 시간을 MM:SS 형식으로 반환하는 함수
         * @param {number} expiryTimestamp - 만료 시간을 초 단위로 나타낸 Unix 타임스탬프
         * @returns {string} - 남은 시간이 MM:SS 형식의 문자열 또는 "토큰이 만료되었습니다" 메시지
         * @private
         */
        const _getRemainingTime = function (expiryTimestamp) {
            const currentTime = Date.now(); // 현재 시간을 밀리초로 가져옴
            const remainingTime = expiryTimestamp * 1000 - currentTime; // 남은 시간을 밀리초로 계산

            if (remainingTime <= 0) {
                return "토큰이 만료되었습니다.";
            }

            const minutes = Math.floor((remainingTime / 1000 / 60) % 60); // 남은 분
            const seconds = Math.floor((remainingTime / 1000) % 60); // 남은 초

            // MM:SS 형식으로 변환
            return `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
        };


        /**
         * 날짜를 yyyyMMddHHmmss 형식으로 변환하는 함수
         * @param {Date} date - 변환할 날짜 객체
         * @returns {string} - yyyyMMddHHmmss 형식의 문자열
         * @private
         */
        const _formatDateToYyyyMMddHHmmss = function (date) {
            const yyyy = date.getFullYear().toString();
            const MM = String(date.getMonth() + 1).padStart(2, '0');
            const dd = String(date.getDate()).padStart(2, '0');
            const HH = String(date.getHours()).padStart(2, '0');
            const mm = String(date.getMinutes()).padStart(2, '0');
            const ss = String(date.getSeconds()).padStart(2, '0');

            return `${yyyy}${MM}${dd}${HH}${mm}${ss}`;
        };


        /**
         * 토큰 만료 여부를 확인하는 함수
         * @param {string} token - 만료 여부를 확인할 JWT 토큰
         * @returns {boolean}
         * @private
         */
        const _isTokenExpired = function (token) {

            const decodedToken = _decodeToken(token);
            if (!decodedToken) return true;

            const now = Math.floor(Date.now() / 1000);
            return decodedToken.exp < now;
        };

        const _base64UrlDecode = function (base64Url) {
            // Base64 URL Safe 형식 -> 일반 Base64 형식으로 변환
            const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
            // 패딩 처리
            const paddedBase64 = base64.padEnd(base64.length + (4 - base64.length % 4) % 4, '=');
            // 디코딩
            return decodeURIComponent(
                atob(paddedBase64)
                    .split('')
                    .map(c => '%' + c.charCodeAt(0).toString(16).padStart(2, '0'))
                    .join('')
            );
        };

        // 공통 함수: 헤더에 Authorization 토큰을 추가
        const _addAuthorizationHeader = function (headers) {

            headers["user_id"] = YTHIPbiz_auth.userId;
            headers["X-CSRF-Token"] = document.querySelector('meta[name="_csrf"]')?.getAttribute('content');
            return headers;
        };

        let _promiseWithHeaders = async (type, url, param, headers = {}) => {
            //YTHIPcomm.indicator(true);

            let dataType = type.toUpperCase();
            headers["X-CSRF-Token"] = document.querySelector('meta[name="_csrf"]')?.getAttribute('content');
            try {
                let _opt = {
                    url: url,
                    type: type,
                    dataType: "json",
                    async: true,
                    cache: false,
                    contentType: "application/x-www-form-urlencoded",
                    "xhrFields": {
                        withCredentials: true  // ✅ 브라우저가 자동으로 `HttpOnly` 쿠키 포함
                    },
                    data: param,
                    headers: headers
                };

                // status와 response 객체를 포함하여 반환
                const response = await $.ajax(_opt).then((data, textStatus, jqXHR) => {
                    return {status: jqXHR.status, data: data};
                });
                return response;
            } catch (e) {
                return e;
            }
        };


        return {
            login: _login,
            userCheck: _userCheck,
            credencialLogin: _credencialLogin,
            logout: _logout,
            refreshAccessToken: _refreshAccessToken,
            decodeToken: _decodeToken,
            isTokenExpired: _isTokenExpired,
            promiseWithHeaders: _promiseWithHeaders,
            printTokenExpiry: _printTokenExpiry,
            getRemainingTime: _getRemainingTime,
            formatDateToYyyyMMddHHmmss: _formatDateToYyyyMMddHHmmss,
            addAuthorizationHeader: _addAuthorizationHeader,
            getUserIdByToken: _getUserIdByToken,
            getPayloadFromToken: _getPayloadFromToken,
            isLogined: _isLogined,
            getLoginedScope: _getLoginedScope,
            storeTokens: _storeTokens,


        };
    }();


