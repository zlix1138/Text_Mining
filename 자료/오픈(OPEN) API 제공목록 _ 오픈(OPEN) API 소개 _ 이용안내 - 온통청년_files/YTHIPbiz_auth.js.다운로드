         * 토큰이 유효한지 체크하고 userdata 리턴
         * @param
         * @returns {object|null}
         * @private
         */
        const _getPayloadFromToken = function () {
            data = {
                userId: null,
                userNm: null,
                userTaskSeCd: null,
            };
            // 토큰의 만료 여부를 확인
            if (!_isLogined()) {
                // _logout(); // 만료된 토큰을 삭제
                // YTHIPcomm.confirm({title:"로그인 알림", msg:"로그인이 필요합니다.", submsg:"로그인 하시겠습니까?"}, $(this), function () {
                // 	YTHIPbiz_auth.route.go(YTHIPbiz_auth.ROUTES.METHOD_INDIVIDUALS_LOGIN);
                // }, function () {
                // 	YTHIPbiz_auth.route.go(YTHIPbiz_auth.ROUTES.MAIN);
                // }, "로그인하기", "메인으로");
                //YTHIPbiz_auth.route.go(YTHIPbiz_auth.ROUTES.MAIN);
                //console.error(Response(401, "토큰이 만료되었습니다."));
                return Response(401, "토큰이 만료되었습니다.", data);
