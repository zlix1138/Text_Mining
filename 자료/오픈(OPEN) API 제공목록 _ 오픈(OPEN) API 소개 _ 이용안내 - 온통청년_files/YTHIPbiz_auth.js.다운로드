         * @returns {Promise}
         * @private
         */
        const _refreshAccessToken = async function () {

            const url = `${YTHIPcomm.API_FRT_URL}/oauth/token`; // 엔드포인트 URL 확인
            const headers = {
                "Content-Type": "application/json" // JSON 형식으로 Content-Type 설정
            };

            const body = JSON.stringify({
                grantType: "refresh_token",
            });

            try {
                const response = await _promiseWithHeaders("POST", url, body, headers);
                if (response) {
                    YTHIPbiz_auth.tokenExpiresIn = response.data.tokenExpiresIn;
                    updateHeader();
                    isExtendPopOpen = false;
                    YTHIPcomm.alert({title: "알림", msg: "로그인이 연장되었습니다."}, $(this));
                } else {
                    YTHIPcomm.alert({title: "알림", msg: "로그인을 연장할 수 없습니다."}, $(this));
                }
            } catch (error) {
                console.error("액세스 토큰 갱신 실패:", error);
                return null;
            }
        };


