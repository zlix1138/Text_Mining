        let _optionData = function(_target, _key){
            let tg = null;
            if(!_target) return false;
            if($.type(_target) == "object"){
                _target = $(_target);
                if(_target.hasClass("modal_popup")){
                    tg = _target;
                }else{
                    tg = _target.closest("div.modal_popup");
                }
            }else{
                tg = $(".modal_popup#"+_target);
            }
            if (tg.length > 0) {
                let popupOptData = tg.data("option_data");
                if(popupOptData){
