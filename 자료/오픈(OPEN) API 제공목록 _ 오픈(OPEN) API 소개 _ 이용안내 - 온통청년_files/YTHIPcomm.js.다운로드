    /**
    Function    :
        YTHIPcomm.cookie.set; 쿠키 셋팅
        YTHIPcomm.cookie.get; 쿠키 반환
        YTHIPcomm.cookie.del; 쿠키 삭제
    Parameter    : - key : 쿠키명
     - val : 쿠키값
     - expdays :쿠키기간
    Examples    :
         - 쿠키 셋팅 : YTHIPcomm.cookie.set(key, val, expdays);
         - 쿠키 반환 : YTHIPcomm.cookie.get(key);
         - 쿠키 삭제 : YTHIPcomm.cookie.del(key);
    Returns    : -
    Notes        : - 쿠키설정
    */
    let _cookie = function(){

        let __set = function(key, val, expdays){
            let todayDate = new Date();
            if(expdays != '0') {
                todayDate.setDate( todayDate.getDate() + expdays );
                document.cookie = key + "=" + escape( val ) + "; path=/; expires=" + todayDate.toGMTString() + ";"
            } else {
                todayDate.setDate( todayDate.getDate());
                document.cookie = key + "=" + escape( val ) + "; path=/;";
            }
        }

        let __get = function(key){
            let nameOfCookie = key + "=";
            let x = 0;
            while ( x <= document.cookie.length ){
                let y = (x+nameOfCookie.length);
                if ( document.cookie.substring( x, y ) == nameOfCookie ){
                    if ( (endOfCookie=document.cookie.indexOf( ";", y )) == -1 )
                        endOfCookie = document.cookie.length;
                    return unescape( document.cookie.substring( y, endOfCookie ) );
                }
                x = document.cookie.indexOf( " ", x ) + 1;
                if ( x == 0 )
                    break;
            }
            return "";
        }

        let __del = function(key){
            let todayDate = new Date();
            todayDate.setDate( todayDate.getDate() );
            document.cookie = key + "=; path=/; expires=" + todayDate + ";"
        }

        return {
            set : __set
            , get : __get
            , del : __del
        }
    }();

