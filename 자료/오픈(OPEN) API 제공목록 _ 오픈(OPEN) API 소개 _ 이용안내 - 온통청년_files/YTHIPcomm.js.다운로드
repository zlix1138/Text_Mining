    let _promise = (type, url, bizParam) => {
        return new Promise((resolve, reject) => {
            YTHIPcomm.indicator(true);

            let headers = {};
            YTHIPbiz_auth.auth.addAuthorizationHeader(headers);

            let dataType = type.toUpperCase();
            type = (type.toUpperCase() === "FILE")? "POST":type.toUpperCase();

            setTimeout(function(){
                //YTHIPutil.log(">>>>> ==== PROMISE AJAX START ====");
                if($.type(bizParam) === 'string' && YTHIPutil.isEmpty(bizParam)) bizParam = {};
                try {
                    if(dataType !== "FILE" && bizParam != null && type === "GET") {
                        bizParam.isMaskingYn = YTHIPcomm.GLOBAL_CONST.isMaskingYn;
                    }

                    let _opt ={
                        "url": url,
                        "headers": headers,
                        "type": type,
                        "dataType": "json",
                        "async" : false,
                        "cache": false,
                        "xhrFields": {
                            withCredentials: true  // ✅ 브라우저가 자동으로 `HttpOnly` 쿠키 포함
                        },
                        "contentType": "application/json",
                        "data": (type != null && type === "GET") ? bizParam : JSON.stringify(bizParam),
                        "success": (response) => {
                            YTHIPcomm.GLOBAL_CONST.isLoadingBar = true;
                            YTHIPcomm.indicator(false);
                            try {
                                //if(LOGIN_YN == "Y") YTHIPcomm.sessionTimer.extend("AJAX");
                                //response && YTHIPutil.log(JSON.stringify(response));
                                if (response){
                                    //console.log('AJAX PROMISE : [' + type.toUpperCase() + '] ' + url, response);
                                    if (response["resultCode"] != undefined && response["resultCode"] != 200) {
                                        YTHIPcomm.alert({title:"통신오류", msg:"데이터 조회 중 에러가 발생했습니다.", submsg:"에러코드 [" + response.resultCode + "]\n메시지 [" + response.resultMessage + "]"});
                                        reject(response);
                                        return;
                                    }else{
                                        resolve(response);
                                    }
                                }
                            } catch (e) {
                                console && YTHIPutil.log(e);
                            }
                        },
                        "error": (xhr, textStatus, errorThrown) => {
                            YTHIPcomm.GLOBAL_CONST.isLoadingBar = true;
                            YTHIPcomm.indicator(false);
                            // console && console.error("%c[AJAX PROMISE ERROR] : %c" + xhr.statusText, "color:yellow; background:#292b2a", "color:red; background:#292b2a");
                            console.warn('통신 오류가 발생했습니다.');
                            //YTHIPcomm.alert({title:"통신오류", msg:"통신이 원활하지 않습니다.", submsg:"잠시 후 다시 시도하시기 바랍니다."});
                            reject(new Error(xhr.statusText));

                        }
                    };

                    if(dataType === "FILE"){
                        _opt["contentType"] = false;
                        _opt["processData"] = false;
                        _opt["data"] = bizParam;
                    }

                    $.ajax(_opt);
                } catch (e) {
                    YTHIPcomm.indicator(false);
                    // console && console.error("%c[AJAX PROMISE Exception] : %c" + e, "color:yellow; background:#292b2a", "color:red; background:#292b2a");
                    console.warn('통신 오류가 발생헀습니다.');
                    //YTHIPcomm.alert({title:"통신오류", msg:"통신이 원활하지 않습니다.", submsg:"잠시 후 다시 시도하시기 바랍니다."});
                    reject(new Error(xhr.statusText));
                }
            }, 500);
        });
    }


    /** ajax type 체크 */
    let _isDataType = function(_dataType){
        switch (_dataType) {
            case "html":
            case "json":
            case "script":
            case "file":
                return true;
                break;
        }
        return false;
    };

    let _appendHidden = function(form, name, value, isArray, type) {
        if (typeof form != 'object' && form.indexOf('#') == -1)
            form = '#' + form;

        if (isArray == undefined || isArray == false) {
            if ($(form).find('[name=' + name + ']').val()) {
                $(form).find('[name=' + name + ']').val(value);
                return $(form).find('[name=' + name + ']');
            }
            $(form).find('[name=' + name + ']').remove();
        }
        if (type == undefined)
            type = 'hidden';

        let input = $("<input />");
        input.attr("name", name).attr("type", type).attr("value", value);

        $(form).append(input);

        return $(input);
    };

    let _jsonObjToForm = function(jsonObj, formId){
        let $tempForm = null;
        if(!formId){
            formId = "_formTemp_";
        }
        $tempForm = $("#"+formId);
        if($tempForm.length > 0){
            $tempForm.remove();
        }
        $tempForm =  $('<form method="post"></form>');
        $tempForm.attr("id", formId).attr("name", formId);
        $("body").append($tempForm);
        $.each(jsonObj, function(_key, _val){
            _appendHidden($tempForm, _key, _val);
        });
        return $tempForm;
    };

    /**
