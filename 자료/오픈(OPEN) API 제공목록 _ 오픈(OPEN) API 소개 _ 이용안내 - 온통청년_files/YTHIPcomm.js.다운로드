     Function        : YTHIPcomm.ajax
     Description    : jquery ajax custom
     Parameter        :
     - url : was url
     - bizParam : "form id" or "form 객체" or "div id" or "div 객체" or "json 객체", 객체의 자식들에 대해서 vaildation체크를 한다. 단 "json 객체"제외.
     - successCallBack : 통신 성공시 실행할 function
     - errorCallBack : 통신 실패시 실행할 function
     - opt : jquery ajax 사용자 option. 기본 option : {"type":"post", "dataType" : "json", "cache":false, "contentType":"application/x-www-form-urlencoded; charset=UTF-8"}
     - dataType : jquery ajax dataType설정["html","json", "script"]. 기본 dataType은 "json"이다.
     Returns        :
     Notes        : form tag 내의 모든 input, textarea, select 의 모든 값을 전달한다. input, textarea, select에 name을 꼭 지정해야 합니다.
     */
    let _ajax = function(url, bizParam, successCallBack, errorCallBack, opt, dataType){
        //YTHIPutil.log(">>>>> =============== AJAX START ===============");
        //YTHIPutil.log(">>>>> ============================================");
        YTHIPcomm.indicator(true);
        let headers = {};
        YTHIPbiz_auth.auth.addAuthorizationHeader(headers);

        setTimeout(function() {
            if(opt !== "html" && $.type(bizParam) === 'string' && YTHIPutil.isEmpty(bizParam)) bizParam = {};
            try {
                let $ajaxParam = null;
                if (bizParam) {
                    let _bizParam = null;
                    if ($.type(bizParam) == "string") {
                        if (!($.type(opt) == "object" && opt["stringYn"] == "Y")) {
                            try {
                                _bizParam = $("#" + bizParam);
                            } catch (e1) {
                                console && YTHIPutil.log(e1);
                            }
                        }
                    } else {
                        _bizParam = $(bizParam);
                    }

                    if (_bizParam && _bizParam["prop"] && (_bizParam["prop"]("tagName") == "FORM" || _bizParam["prop"]("tagName") == "DIV")) {
                        if (!YTHIPcomm.validate.check(bizParam)) {
                            setTimeout(function () {
                                YTHIPcomm.indicator(false);
                            }, 20);
                            return "ERROR:validate check";
                        }
                        let $locationForm = _bizParam;
                        $ajaxParam = $locationForm.toJson();
                    } else {
                        $ajaxParam = bizParam;
                    }
                }

                if ($.type(opt) === "string" && _isDataType(opt)) {
                    dataType = opt;
                    opt = null;
                }
                if ($.type(errorCallBack) === "string" && _isDataType(errorCallBack)) {
                    dataType = errorCallBack;
                    errorCallBack = null;
                }
                if ($.type(errorCallBack) !== "function" && $.type(errorCallBack) === "object" && !opt) {
                    opt = errorCallBack;
                    errorCallBack = null;
                }

                if(dataType !== "file" && opt != null && opt.type.toUpperCase() === "GET") {
                    bizParam.isMaskingYn = YTHIPcomm.GLOBAL_CONST.isMaskingYn;
                }

                //if(dataType != "html") YTHIPutil.log("AJAX : [" + opt.type + "] " + url);
                let _opt = {
                    "url": url,
                    "headers": headers,
                    "type": "post",
                    "dataType": "json",
                    "async" : false,
                    "cache": false,
                    "xhrFields": {
                        withCredentials: true  // ✅ 브라우저가 자동으로 `HttpOnly` 쿠키 포함
                    },
                    "contentType": "application/json",
                    "data": (opt != null && opt.type === "GET") ? $ajaxParam : JSON.stringify($ajaxParam),
                    "success": function (response) {
                        YTHIPcomm.GLOBAL_CONST.isLoadingBar = true;
                        //if(dataType != "html") YTHIPutil.log("AJAX DONE : " + response.resultCode + ", " + response.resultMessage);
                        YTHIPcomm.indicator(false);
                        try {
                            //if(LOGIN_YN == "Y") YTHIPcomm.sessionTimer.extend("AJAX");
                            //response && YTHIPutil.log(JSON.stringify(response));
                            if (dataType !== "html" && response){
                                //console.log('AJAX : [' + opt.type.toUpperCase() + '] ' + url, response);
                                if (response["resultCode"] != undefined && response["resultCode"] != 200) {
                                    if (errorCallBack && $.type(errorCallBack) == "function") {
                                        response["responseText"] = response["errorMessage"];
                                        YTHIPcomm.alert({title:"통신오류", msg:"데이터 조회 중 에러가 발생했습니다.", submsg:"에러코드 [" + response.resultCode + "]\n메시지 [" + response.resultMessage + "]"}, null, errorCallBack(response, response["errorCode"]));
                                    }else{
                                        YTHIPcomm.alert({title:"통신오류", msg:"데이터 조회 중 에러가 발생했습니다.", submsg:"에러코드 [" + response.resultCode + "]\n메시지 [" + response.resultMessage + "]"});
                                    }
                                    return;
                                }
                                if (response["results"] != undefined && response["results"]["common"]["errorCode"] != 0) {
                                    let tmpMessage = "데이터 조회 중 에러가 발생했습니다.";
                                    if(response["results"]["common"]["errorCode"] === "E0015"){
                                        tmpMessage = "검색 결과가 너무 많습니다. 상세주소로 검색해주세요.";
                                    }
                                    if (errorCallBack && $.type(errorCallBack) == "function") {
                                        response["responseText"] = response["results"]["common"]["errorMessage"];
                                        YTHIPcomm.alert({title:"통신오류", msg:tmpMessage, submsg:"에러코드 [" + response["results"]["common"]["errorCode"] + "]\n메시지 [" + response["results"]["common"]["errorMessage"] + "]"}, null, errorCallBack(response, response["errorCode"]));
                                    }else{
                                        YTHIPcomm.alert({title:"통신오류", msg:tmpMessage, submsg:"에러코드 [" + response["results"]["common"]["errorCode"] + "]\n메시지 [" + response["results"]["common"]["errorMessage"] + "]"});
                                    }
                                    return;
                                }
                            }

                            //successCallBack && successCallBack(($.type(response) === "string" && _opt.url.indexOf(YTHIPcomm.API_FRT_URL) !== -1 && dataType != "html")? JSON.parse(response):response);
                            successCallBack && successCallBack(response);
                        } catch (e) {
                            console && YTHIPutil.log(e);
                        }
                    },
                    "error": function (xhr, textStatus, errorThrown) {
                        YTHIPcomm.GLOBAL_CONST.isLoadingBar = true;
                        YTHIPcomm.indicator(false);
                        // console && console.error("%c[AJAX ERROR] : %c" + xhr.statusText, "color:yellow; background:#292b2a", "color:red; background:#292b2a");
                        // YTHIPcomm.alert({title:"통신오류", msg:"통신이 원활하지 않습니다.\n잠시 후 다시 시도하시기 바랍니다."});
                        console.warn('통신 오류로 인한 서비스 호출 실패');

                        //console && console.log("%cajax Error : " + JSON.stringify({"xhr": xhr, "textStatus": textStatus, "errorThrown": errorThrown}), "color:red; background:#292b2a");
                        if($.type(errorCallBack) === "function") {
                            YTHIPcomm.indicator(false);
                            //YTHIPcomm.alert({title:"통신오류", msg:"통신이 원활하지 않습니다.\n잠시 후 다시 시도하시기 바랍니다."}, null, errorCallBack());
                        }else{
                            //YTHIPcomm.alert({title:"통신오류", msg:"통신이 원활하지 않습니다.\n잠시 후 다시 시도하시기 바랍니다."});
                        }

                    }
                };
                if (opt) _opt = $.extend(_opt, opt);

                if(dataType === "file"){
                    _opt["contentType"] = false;
                    _opt["processData"] = false;
                    _opt["data"] = bizParam;
                }

                if(dataType === "html"){
                    _opt["dataType"] = dataType;
                    _opt["type"] = "GET";
                }

                // 프론트서버 경유 API 일경우 String으로 받도록 처리
                //if(_opt.url.indexOf(YTHIPcomm.API_FRT_URL) !== -1){
                //    _opt["dataType"] = "text";
                //}
                //if (dataType) _opt["dataType"] = dataType;
                //if (oriDataType) _opt["type"] = "GET"; // 이건 작동여부에 따라 삭제해야 할 수도..
                $.ajax(_opt);
            } catch (e) {
                YTHIPcomm.indicator(false);
                // console && console.error("%c[AJAX Exception] : %c" + e, "color:yellow; background:#292b2a", "color:red; background:#292b2a");
                // YTHIPcomm.alert({title:"통신오류", msg:"통신이 원활하지 않습니다.", submsg:"잠시 후 다시 시도하시기 바랍니다."});
                console.warn('통신 오류로 인한 서비스 호출 실패');


                if ($.type(errorCallBack) === "function"){
                    YTHIPcomm.indicator(false);
                    //YTHIPcomm.alert({title:"통신오류", msg:"통신이 원활하지 않습니다.", submsg:"잠시 후 다시 시도하시기 바랍니다."}, null, errorCallBack());
                } else{
                    //YTHIPcomm.alert({title:"통신오류", msg:"통신이 원활하지 않습니다.", submsg:"잠시 후 다시 시도하시기 바랍니다."});
                }

            }
        }, 0);
    };
