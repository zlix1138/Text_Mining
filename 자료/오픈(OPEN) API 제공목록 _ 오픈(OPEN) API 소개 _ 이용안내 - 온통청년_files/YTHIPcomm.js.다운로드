                if( callback ){
                    callback({
                        "timerResult"    : false,
                        "timerSelecter"    : selecter,
                        "timeNum"        : _timeArray([timerHours*1,timerMinutes*1,timerSeconds*1]),
                        "timeSeconds"    : timeSeconds
                    });
                }
            }
        },1000);
        $(selecter).closest(".modal_popup").data("timer", timerTg);
    };

