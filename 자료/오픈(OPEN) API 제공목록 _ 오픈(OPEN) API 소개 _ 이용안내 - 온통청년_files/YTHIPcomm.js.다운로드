     Examples    :
     // <input type="text" id="timer"/>
     - YTHIPcomm.timer($("#timer"),"03:00",function(result){});
     - YTHIPcomm.timer("03:00",function(result){});        // 3분 타이머 적용
     - YTHIPcomm.timer(60, function(result){});            // 1분20초 타이머 적용
