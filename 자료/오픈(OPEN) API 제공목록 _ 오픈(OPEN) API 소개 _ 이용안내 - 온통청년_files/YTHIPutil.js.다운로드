            window.open(url, '_blank');
        };

        let _band = function (link, title) {
            link = encodeURIComponent(link);
            title = encodeURIComponent(title);

            var url = 'http://band.us/plugin/share?body=' + title + '&route=' + link;
            window.open(url, '_blank');
        };

        let _blog = function (link, title) {
            link = encodeURIComponent(link);
            title = encodeURIComponent(title);

            var url = 'http://blog.naver.com/openapi/share?url=' + link + '&title=' + title;
            window.open(url, '_blank');
        };

        let _twitter = function (link, title) {
            link = encodeURIComponent(link);
            title = encodeURIComponent(title);

            var url = 'https://twitter.com/share?url=' + link + '&text=' + title;
            window.open(url, '_blank');
        };

        let _kakao = function (link, title) {
            if (!Kakao.isInitialized()) {
                Kakao.init(YTHIPcomm.KEY_API_KAKAO); // 운영용
