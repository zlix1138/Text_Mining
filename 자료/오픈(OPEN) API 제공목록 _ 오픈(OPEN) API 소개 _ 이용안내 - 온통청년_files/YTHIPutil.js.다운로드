                    alert('종료일 날짜입력 오류입니다.', $endObj);
                    $endObj.val(YTHIPutil.date.getTodayDate(null, dilimeter));
                    return false;
                }
                $endObj.val(endYear + dilimeter + endMonth + dilimeter + endDay + lastDelimeter);
            }

            if (tempStartDate && tempLeaveDate) {
                if (tempLeaveDate < tempStartDate) {
                    alert('시작일이 종료일 보다 클 수 없습니다.', $startObj);
                    $startObj.val(YTHIPutil.date.getTodayDate(null, dilimeter));
                    $endObj.val(YTHIPutil.date.getTodayDate(null, dilimeter));
                    return false;
                }
            }
            if (sDateMinDate && sDateMinDate > tempStartDate) {
                alert('최소 시작일 보다 작을 수 없습니다.', $startObj);
                $startObj.val(YTHIPutil.date.getTodayDate(null, dilimeter));
                return false;
