        let _formatDate = function (date, delimiter, isIncludeTime, timeDelimiter) {
            let returnValue = "";
            try {
                if (!YTHIPutil.isEmpty(date)) {
                    let str = date.toString().replace(/[\-\:\. ]/g, '');
                    if ($.isNumeric(date)) str = new String(date);
                    let y = str.substr(0, 4),
                        m = str.substr(4, 2),
                        d = str.substr(6, 2);


                    returnValue = (delimiter) ? (y + delimiter + m + delimiter + d) : (y + '.' + m + '.' + d);
                    if (YTHIPutil.validate.isBoolean(isIncludeTime) && str.length > 8) {
                        let h = str.substr(8, 2),
                            i = str.substr(10, 2),
                            s = str.substr(12, 2);

                        returnValue += ' ' + ((timeDelimiter) ? (h + timeDelimiter + i + timeDelimiter + s) : (h + ':' + i + ':' + s));
                    }
                }
            } catch (e) {
                console.log(e);
            }
            return returnValue;
        };

        let _parseDate = function (date, delimiter) {
            let str = date;
            if ($.isNumeric(date)) str = new String(date);
            let y = str.substr(0, 4),
                m = str.substr(4, 2) - 1,
                d = str.substr(6, 2);

            if (delimiter) {
                return new Date(y + delimiter + m + delimiter + d);
            } else {
                return new Date(y, m, d);
            }
        };

