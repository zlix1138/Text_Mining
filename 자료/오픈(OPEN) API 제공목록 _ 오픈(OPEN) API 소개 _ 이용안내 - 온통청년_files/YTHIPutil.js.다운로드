    const _search = function () {
        const _get = function ($this) {
            let param = [];
            $("input, select", $this).each(function (i, v) {
                console.log($(this).prop("tagName"));
                if ("INPUT" === $(this).prop("tagName")) {
                    if ($(this).prop("type") !== "button") {
                        param.push($(this).prop("id") + ':' + $(this).val());
                    }
                }
                if ("SELECT" === $(this).prop("tagName")) {
                    param.push($(this).prop("id") + ':' + $(this).find("option:selected").val());
                }
            });
            //param.push('curPageNum:'+curPageNum);
            //param.push('pstSeSn:'+pstSeSn);

            return param.join(';');
        };

        const _set = function ($this, srchParam, callbackFn) {
            if (!YTHIPutil.isEmpty(srchParam)) {
                const srchParamArr = srchParam.split(';');
                $.each(srchParamArr, function (i, v) {
                    const tmpParam = v.split(':');
                    //if (tmpParam[0] === 'curPageNum') curPageNum = tmpParam[1];
                    //if (tmpParam[0] === 'pstSeSn'){
