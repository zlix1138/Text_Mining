        /**
         Function : 뒷자리 마킹
         Note : 정해진 수만큼 뒷자리 * 마킹
         YTHIPutil.format.markingFormat('ASDF', 2)
         */
        let _markingFormat = function (str, num) {
            str = str + "";
            let temp = "";
            if (str.length > num) {
                temp = str.substring(0, str.length - num);
                for (let i = 0; i < num; i++) {
                    temp += "*";
                }
            }
            return temp;
        };

        /**
         Function : 휴대번호 뒷자리 마스킹
         Note : 휴대번호 뒷자리 마스킹
         YTHIPutil.format.maskingHpNo('ASDF')
         */
        let _maskingHpNo = function (str) {
            if (0 > str.indexOf('-')) {
                str = _dashHpNo(str);
            }
            return _markingFormat(str, 4);
        };

