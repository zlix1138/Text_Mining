        /**
         Function	: YTHIPutil.date.getTodayDate(isMonth)
         Description	: 현재 날짜를 가져온다.
         Parameter	: - isMonth	: true
         Examples	: > YTHIPutil.date.getTodayDate(), YTHIPutil.date.getTodayDate('m')
         Returns		: true/false
         Notes		: 현재날짜를 "년월" 또는 "년월일"로 반환한다.
         */
        let _getTodayDate = function (isMonth, delimiter) {
            let toDayObj = new Date();
            let monthObj = {
                '0': '01',		//'JAN',
                '1': '02',		//'FEB',
                '2': '03',		//'MAR',
                '3': '04',		//'APR',
                '4': '05',		//'MAY',
                '5': '06',		//'JUN',
                '6': '07',		//'JUL',
                '7': '08',		//'AUG',
                '8': '09',		//'SEP',
                '9': '10',		//'OCT',
                '10': '11',	//'NOV',
                '11': '12'		//'DEC'
            };
            let year = toDayObj.getFullYear();
            let month = monthObj[toDayObj.getMonth()];
            let date = toDayObj.getDate();
            if (10 > parseInt(date || '')) {
                date = '0' + date;
            }

            let lastDelimeter = "";
            if (delimiter == ".") {
                lastDelimeter = ".";
            }
            if (isMonth) {
                if (delimiter) return year + delimiter + month + lastDelimeter;
                return year + month;
            } else {
                if (delimiter) return year + delimiter + month + delimiter + date + lastDelimeter;
                return year + month + date;
            }
        };

        /**
         Function	: YTHIPutil.date.getTime(type)
         Description	: 현재 시간을 가져온다.
         Parameter	: - type : 시간형식 ('hh', 'mm', 'ss')
         Examples	: > YTHIPutil.date.getTime(), YTHIPutil.date.getTime('hh'), YTHIPutil.date.getTime('mm'), YTHIPutil.date.getTime('ss')
         Returns		: true/false
         Notes		: 현재 시간을 옵션에 따라 "시분초" 또는 "시", "분", "초"로 반환한다.
         */
        let _getTime = function (type) {
            let date = new Date();
            let hour = '';
            let min = '';
            let sec = '';
            if (undefined == type) {
                type = 'hhmmss';
            }
            if (type.indexOf('hh') != -1) {
                hour = date.getHours().toString();
                hour = hour.length == 1 ? '0' + hour : hour;
            }
            if (type.indexOf('mm') != -1) {
                min = date.getMinutes().toString();
                min = min.length == 1 ? '0' + min : min;
            }
            if (type.indexOf('ss') != -1) {
                sec = date.getSeconds().toString();
                sec = sec.length == 1 ? '0' + sec : sec;
            }
            return hour + min + sec;
        };

        /** 현재 날짜,시간 출력
         * 현재 날짜와 시간을 yyyy.mm.dd hh24:mi:ss 형식으로 출력
         */
        let _getDateTime = function () {
            let date = YTHIPutil.date.getTodayDate();
            let time = YTHIPutil.date.getTime();
            let str = '';
            str += date.substring(0, 4) + '.' + date.substring(4, 6) + '.' + date.substring(6, 8) + '. ';
            str += time.substring(0, 2) + ':' + time.substring(2, 4) + ':' + time.substring(4, 6);
            return str;
        };

        /**
         Function	: YTHIPutil.date.getDayOfWeek(datestr)
         Description	: 해당 날짜의 요일 값 리턴
         Parameter	: - obj		: YTHIPutil.date.getHoliday()
         : - selDate : 날짜
         Examples	: > YTHIPutil.date.getDayOfWeek('20190101')
         Returns		: 0-6
         Notes		: 당 날짜(YYYYMMDD)의 요일 값 리턴 - 0(일요일) ~ 6(토요일)
         */
        let _getDayOfWeek = function (datestr) {
            let yyyy = parseInt(datestr.substring(0, 4), 10);
            let mm = parseInt(datestr.substring(4, 6), 10) - 1;
            let dd = parseInt(datestr.substring(6), 10);

            let date = new Date(yyyy, mm, dd);

            return date.getDay();
        };

        /**
         Function	: YTHIPutil.date.addDays(datestr,type,addDate)
         Description	: 입력받은 날짜에 타입의 수만큼  더하거나 빼고 리턴
         Parameter	: - datestr		: 비교일자
         : - type			: type('year','month','day')
         : - addDate		: 더하거나 뺄(-) 숫자
         Examples	: > YTHIPutil.date.addDays('20190107', 'day', 1)
         Returns		: "20190108"
         Notes		: 일, 월, 년을 모두 비교 할 수 있다.
         */
        let _addDays = function (datestr, type, addDate) {
            if (typeof (addDate) != 'number') return datestr;
            let yyyy = parseInt(datestr.substring(0, 4), 10);
            let mm = parseInt(datestr.substring(4, 6), 10) - 1;
            let dd = parseInt(datestr.substring(6), 10);
            if (type == 'year') {
                yyyy += addDate;
            } else if (type == 'month') {
                mm += addDate;
            } else if (type == 'day') {
                dd += addDate;
            } else {
                return datestr;
            }
            let date = new Date(yyyy, mm, dd);
            let rtYyyy = date.getFullYear();
            let rtMm = date.getMonth() + 1;
            let rtDd = date.getDate();
            if (rtMm < 10) {
                rtMm = '0' + rtMm;
            }
            if (rtDd < 10) {
                rtDd = '0' + rtDd;
            }
            return '' + rtYyyy + rtMm + rtDd;
        };


        let _calDate = function (date) {
            let day = date;

            if (typeof (day) == 'number') {
                day = String(day);
            }
            let choiceday = day;
            let today = _getTodayDate();
            choiceday = choiceday.replace(/[.?]/g, '');
            today = today.replace(/[.?]/g, '');
            let date1_yy = Number(choiceday.substring(0, 4));
            let date1_mm = Number(choiceday.substring(4, 6));
            let date1_dd = Number(choiceday.substring(6, 8));
            let date2_yy = Number(today.substring(0, 4));
            let date2_mm = Number(today.substring(4, 6));
            let date2_dd = Number(today.substring(6, 8));
            let chw_DAY = "0";
            if (((date1_yy % 4 == 0) && (date1_yy % 100 != 0)) || (date1_yy % 400 == 0)) {
                chw_DAY = "29";
            } else {
                chw_DAY = "28";
            }
            let diff_MM = (date1_yy - date2_yy) * 12 + (date1_mm - date2_mm);
            let diff_DD = date1_dd - date2_dd;

            if (diff_DD < 0) {
                diff_MM = diff_MM - 1;
                diff_DD = diff_DD + new Date(date2_yy, date2_mm, 0).getDate();
            }
            return {
                "MM": diff_MM,
                "DD": diff_DD
            };
        };

        let _getMyAge = function (idNum) {
            let toDay = _getTodayDate();
            let year = "";
            let month = "";
            let day = "";
            let myYear = ""; 	//생일
            let myAge = 0; 	//만 나이
            year = toDay.substring(0, 4);
            month = toDay.substring(4, 6);
            day = toDay.substring(6, 8);
            if (idNum.charAt(6) == '1' || idNum.charAt(6) == '2' || idNum.charAt(6) == '5' || idNum.charAt(6) == '6') {
                myYear = "19" + idNum.substring(0, 2);
            } else {
                myYear = "20" + idNum.substring(0, 2);
            }
            if (Number(month) > Number(idNum.substring(2, 4))) {
                myAge = Number(year) - Number(myYear);
            } else if (Number(month) == Number(idNum.substring(2, 4))) {
                if (Number(day) > Number(idNum.substring(4, 6))) {
                    myAge = Number(year) - Number(myYear);
                } else {
                    myAge = Number(year) - (Number(myYear) + 1);
                }
            } else {
                myAge = Number(year) - (Number(myYear) + 1);
            }
            return myAge;
        };

