         */
        let _int = function (val, intVal) {
            let ret = 0;

            if (undefined === val || '' === val) {
                YTHIPutil.log(val);
                if (undefined != intVal && '' != intVal) {
                    ret = intVal;
                } else {
                    ret = '';
                }
            } else {
                ret = parseInt(val);
                if (isNaN(ret))
                    ret = null;
            }

            return ret;
        };

        /**
         parseFloat 값 변환시 Nan값 이면 Null을 전달 하거, 두번째 Parameter 값을 전달 한다.
