    let _validate = function () {

        /**
         Function	: YTHIPutil.validate.getOnlyNumber(val)
         Description	: 숫자를 제외한 모든 문자를 제거
         Parameter	: - val : 문자열
         Examples	: > YTHIPutil.validate.getOnlyNumber('가나다123abc456')
         Returns		: "123456"
         Notes		: 숫자를 제외한 모든 문자를 제거 후 리턴
         */
        let _getOnlyNumber = function (val) {
            return $.trim(val).replace(/[^\d]/g, '');
        };

        /**
         Function	: YTHIPutil.validate.inputNumberCheck($inpObject)
         Description	: 입력한 데이터의 숫자여부 체크
         Parameter	: - $inpObject : inputbox selector
         : - isDate : 날짜여부
         Examples	: > YTHIPutil.validate.inputNumberCheck($('#_testInputNumberCheck'))
         Returns		: true/false
         Notes		: 숫자 이외의 문자 입력시 리턴메세지
         : 단, '-,.' 의 문자는 예외처리된다. (날짜의 '-', 금액의 천단위 ',' , 이율의 소수점 '.' 등은 예외처리 한다.)
         */
        let _inputNumberCheck = function ($inpObject, isDate) {
            let inpText = $inpObject.val();
            if (!_isNumeric(inpText.replace(/[-,\.]/g, ''))) {
                _inputBack(isDate, inpText, $inpObject);
                let msg = '숫자만 입력하세요.';
                alert(msg);
                return false;
            }
            return true;
        };

        /**
         Function	: YTHIPutil.validate.inputIntegerCheck($inpObject)
         Description	: 입력한 데이터의 자연수여부 체크
         Parameter	: - $inpObject : inputbox selector
         Examples	: > YTHIPutil.validate.inputIntegerCheck($('#_testInputNumberCheck'))
         Returns		: true/false
         Notes		: 숫자 이외의 문자 입력시 리턴메세지
         */
        let _inputIntegerCheck = function ($inpObject, isDate) {
            let inpText = $inpObject.val();
            if (!_isNumeric(inpText) || (inpText.length == 1 && inpText == '0')) {
                _inputBack(isDate, inpText, $inpObject);
                let chkMsg = '0 이상의 정수를 입력하세요'
                alert(chkMsg);
                return false;
            }
            return true;
        };

        /**
         Function	: YTHIPutil.validate.inputNumberCheckAmt($inpObject)
         Description	: 금액 체크
         Parameter	: - $inpObject : inputbox selector
         Examples	: > YTHIPutil.validate.inputNumberCheckAmt($('#_testInputNumberCheck'))
         Returns		: true/false
         Notes		: 입력한 숫자에 3자리 수마다 ','를 찍어서 변환.
         */
        let _inputNumberCheckAmt = function ($inpObject) {
            let inpText = $inpObject.val() + '';
            inpText = inpText.replace(/[-,\.]/g, '')
            if (!_isNumeric(inpText)) {
                alert('숫자만 입력해주시기 바랍니다.');
                $inpObject.val(YTHIPutil.format.insertComma(_getOnlyNumber(inpText)));
                return false;
            }
            $inpObject.val(YTHIPutil.format.insertComma(inpText));
            return true;
        };

        /**
         Function : 숫자입력 Key Up
         Note : 숫자입력시 입력된 값을 확인
         > YTHIPutil.validate.inputNumberKeyUpEvent($('#_testInputNumberCheck'))
         */
        let _inputNumberKeyUpEvent = function ($this, $next, len) {
            if (_inputNumberCheck($this)) {
                if (len == undefined) {
                    return;
                }
            }
        };

        /**
         Function : 전화번호 숫자입력 Key Up
         Note : 숫자입력시 입력된 값을 확인. 정수(음수제외)만 가능 (전화번호에서 사용)
         */
        let _inputTelNumberKeyUpEvent = function ($inpObject) {
            let inpText = $inpObject.val();
            inpText = inpText.replace(/[-]/g, '');
            if (!_isNumeric(inpText)) {
                _inputBack(undefined, inpText, $inpObject);
                let msg = '숫자만 입력하세요.';
                alert(msg);
                return false;
            }
            return true;
        };

        /**
         Function : 숫자여부 체크
         Note : 입력된 값의 숫자 여부 체크
         YTHIPutil.validate.isNumeric('12345')
         */
        let _isNumeric = function (s) {
            for (let i = 0; i < s.length; i++) {
                let c = s.substr(i, 1);
                if (c < '0' || c > '9') {
                    return false;
                }
            }
            return true;
        };

        /**
         Function : 입력 롤백
