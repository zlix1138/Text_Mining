                    $("[data-objid=" + tmpParam[0] + "]", $this).data("comcd", tmpParam[1]);
                    //}else {
                    $("#" + tmpParam[0], $this).val(tmpParam[1]);
                    //}
                    //}
                })
            }
            if (callbackFn != null && $.type(callbackFn) === "function") {
                setTimeout(function () {
                    callbackFn();
                }, 500);
            }
        }

        return {
            get: _get
            , set: _set
        }
    }();

