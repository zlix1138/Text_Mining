        /**
         Function	: YTHIPutil.format.hangleReturn(val)
         Description	: 숫자 금액을 한글 숫자로 리턴
         Parameter	:
         - val	: 금액
         Examples	: > YTHIPutil.format.hangleReturn('248000');
         > '이십사만팔천원'
         Returns		: [string]
         Notes		:
         */
        let _hangleReturn = function (val) {
            let amount = $.trim(val);
            let amountHan = "";
            if (amount) {
                let amountArray1 = ["", "일", "이", "삼", "사", "오", "육", "칠", "팔", "구"];
                let amountArray2 = ["", "", "십", "백", "천", "만", "십만", "백만", "천만", "억", "십억", "백억", "천억", "조", "십조", "백조", "천조", "경"];
                for (let i = 0; i < amount.length; i++) {
                    let tempAmount = amount.substring(i, amount.length);
                    amountHan += amountArray1[amount[i] * 1];
                    if (tempAmount[0] == '0')
                        continue;
                    let amt1 = amountArray2[tempAmount.length];
                    let amt2 = amountArray2[tempAmount.length - 1];
                    if (amountHan.indexOf("조") != -1 && amt1.indexOf("조") != -1) {
                        amountHan = amountHan.replace("조", "");
                    }
                    if (amountHan.indexOf("억") != -1 && amt1.indexOf("억") != -1) {
                        amountHan = amountHan.replace("억", "");
                    }
                    if (amountHan.indexOf("만") != -1 && amt1.indexOf("만") != -1) {
                        amountHan = amountHan.replace("만", "");
                    }
                    if (amt1.substring(amt1.length - 1, amt1.length) == amt2.substring(amt2.length - 1, amt2.length)) {
                        if (amount.substring(i + 1, amount.length)[0] == '0')
                            amountHan += amt1;
                        else
                            amountHan += amt1.substring(0, 1);
                    } else {
                        amountHan += amt1;

                    }
                }
            } else {
                amountHan += '';
            }
            return amountHan;
        };

        /**
         * Function    : YTHIPutil.format.hangleWithNumberReturn(val)
         * Description : 숫자를 한국식 단위(억, 만 등)로 변환하여 리턴
         * Parameter   :
         * - val       : 금액 (숫자 또는 문자열 형태의 숫자)
         * Examples    :
         *   formatKoreanNumber(200000000); // "2억"
         *   formatKoreanNumber(35000000);  // "3천5백만"
         *   formatKoreanNumber(123456789); // "1억 2천3백4십5만 6천7백8십9"
         * Returns    : [string]
         */
        let _hangleWithNumberReturn = function (val) {
            let amount = String(val).trim();
            if (!/^\d+$/.test(amount)) return '';

            const units = ["", "만", "억", "조", "경"];
            const placeNames = ["", "십", "백", "천"];

            let result = "";
            let unitIndex = 0;

            while (amount.length > 0) {
                let part = amount.slice(-4);
                amount = amount.slice(0, -4);

                if (part !== "0000") {
                    let subResult = "";
                    for (let i = 0; i < part.length; i++) {
                        let num = parseInt(part[i], 10);
                        if (num !== 0) {
                            subResult += num + placeNames[part.length - 1 - i];
                        }
                    }
                    if (subResult) {
                        result = subResult + units[unitIndex] + (result ? result : "");
                    }
                }
                unitIndex++;
            }

            return result.trim();
        };

