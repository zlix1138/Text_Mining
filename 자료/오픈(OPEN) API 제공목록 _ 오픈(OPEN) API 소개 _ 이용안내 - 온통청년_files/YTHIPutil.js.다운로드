            str = str.replace('광역시', '');
            str = str.replace('특별자치시', '');
            str = str.replace('특별자치도', '');
            str = str.replace('충청남도', '충남');
            str = str.replace('충청북도', '충북');
            str = str.replace('전라남도', '전남');
            str = str.replace('전라북도', '전북');
            str = str.replace('경상남도', '경남');
            str = str.replace('경상북도', '경북');
            str = str.replace('경기도', '경기');
            return str;
        }

