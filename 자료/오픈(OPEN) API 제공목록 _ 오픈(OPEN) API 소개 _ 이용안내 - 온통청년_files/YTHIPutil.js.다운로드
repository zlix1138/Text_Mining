        let _checkStartEndDate = function ($startObj, $endObj, sDateMinDate, eDateMaxDate) {
            let startDate = new Date();
            let leaveDate = new Date();
            let tempStartDate;
            let tempLeaveDate;
            let dateFormat = $startObj.data('dateFormat');
            let dilimeter;
            if (dateFormat)
                dilimeter = dateFormat.substr(2, 1);
            else
                dilimeter = '.';

            let lastDelimeter = "";
            if (dilimeter == ".") {
                lastDelimeter = ".";
            }
            if ($startObj != undefined) {
                tempStartDate = _getOnlyNumber($startObj.val());
                let startYear = tempStartDate.length == 8 ? tempStartDate.substr(0, 4) : '';
                let startMonth = tempStartDate.length == 8 ? tempStartDate.substr(4, 2) : '';
                let startDay = tempStartDate.length == 8 ? tempStartDate.substr(6, 2) : '';
                if (startYear == '' || startMonth == '' || startDay == '') {
                    alert('시작일 날짜입력 오류입니다.', $startObj);
                    $startObj.val(YTHIPutil.date.getTodayDate(null, dilimeter));
                    return false;
                }
                $startObj.val(startYear + dilimeter + startMonth + dilimeter + startDay + lastDelimeter);
            }

            if ($endObj != undefined) {
                tempLeaveDate = _getOnlyNumber($endObj.val());
                let endYear = tempLeaveDate.length == 8 ? tempLeaveDate.substr(0, 4) : '';
                let endMonth = tempLeaveDate.length == 8 ? tempLeaveDate.substr(4, 2) : '';
                let endDay = tempLeaveDate.length == 8 ? tempLeaveDate.substr(6, 2) : '';
